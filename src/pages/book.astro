---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Book Appointment | Parker Modern Classic Hair">
  <header style="position: fixed; inset: 0 0 auto 0; z-index: 50; background: rgba(7,7,7,0.75); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(255,255,255,0.04);">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between; height: 72px;">
      <a href="/" style="font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; font-weight: 600; letter-spacing: 0.18em; color: var(--text);">PARKER</a>
      <a href="/" style="font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase;">Home</a>
    </div>
  </header>

  <section style="padding-top: 7rem; min-height: 100vh;">
    <div class="container" style="max-width: 720px;">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <p style="color: var(--accent); letter-spacing: 0.22em; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.5rem;">The Chair</p>
        <h1 style="font-size: clamp(2.8rem, 5vw, 4rem);">Book Your Appointment</h1>
        <p style="color: var(--muted); margin-top: 0.75rem;">Select a service, choose a time, and lock it in.</p>
      </div>

      <div id="booking-app" style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 2rem;">
        <div id="progress" style="display: flex; justify-content: space-between; margin-bottom: 2rem; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);">
          <span data-step="1">Service</span>
          <span data-step="2">Date</span>
          <span data-step="3">Time</span>
          <span data-step="4">Details</span>
          <span data-step="5">Done</span>
        </div>

        <div id="step-1" class="step">
          <h2 style="font-size: 1.8rem; margin-bottom: 1.25rem;">Choose a Service</h2>
          <div id="services" style="display: grid; gap: 0.75rem;"></div>
        </div>

        <div id="step-2" class="step" style="display: none;">
          <h2 style="font-size: 1.8rem; margin-bottom: 1.25rem;">Select a Date</h2>
          <div id="dates" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 0.6rem;"></div>
        </div>

        <div id="step-3" class="step" style="display: none;">
          <h2 style="font-size: 1.8rem; margin-bottom: 1.25rem;">Available Times</h2>
          <div id="times" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 0.6rem;"></div>
        </div>

        <div id="step-4" class="step" style="display: none;">
          <h2 style="font-size: 1.8rem; margin-bottom: 1.25rem;">Your Details</h2>
          <form id="details-form" style="display: grid; gap: 0.85rem;">
            <input type="text" id="name" placeholder="Full Name" required style="padding: 0.95rem 1rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; color: var(--text); font-size: 1rem;" />
            <input type="tel" id="phone" placeholder="Phone Number" required style="padding: 0.95rem 1rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; color: var(--text); font-size: 1rem;" />
            <input type="email" id="email" placeholder="Email (optional)" style="padding: 0.95rem 1rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; color: var(--text); font-size: 1rem;" />
            <textarea id="notes" placeholder="Notes for Ben (optional)" rows="3" style="padding: 0.95rem 1rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; color: var(--text); font-size: 1rem; resize: vertical;"></textarea>
            <button type="submit" class="btn" style="margin-top: 0.5rem;">Confirm Booking</button>
          </form>
        </div>

        <div id="step-5" class="step" style="display: none; text-align: center;">
          <div style="font-size: 3.5rem; margin-bottom: 0.75rem;">✅</div>
          <h2 style="font-size: 2.2rem; margin-bottom: 0.75rem;">You're Booked</h2>
          <div id="confirmation" style="background: var(--surface-2); padding: 1.5rem; border-radius: 12px; margin: 1.5rem 0; text-align: left; border: 1px solid var(--border);"></div>
          <p style="color: var(--muted); margin-bottom: 1.75rem;">Ben will reach out to confirm. See you in the chair.</p>
          <a href="/" class="btn">Back to Home</a>
        </div>

        <div style="margin-top: 1.75rem;">
          <button id="back-btn" class="btn btn-outline" style="display: none; padding: 0.7rem 1.4rem;">Back</button>
        </div>
      </div>
    </div>
  </section>

  <script>
    const services = [
      { id: 'mens', name: "Men’s Haircut", duration: 30, price: '$38' },
      { id: 'beard', name: 'Beard', duration: 30, price: '$25' },
      { id: 'combo', name: "Men’s Haircut & Beard", duration: 60, price: '$55' },
      { id: 'kids', name: "Kid's Haircut", duration: 30, price: '$35' },
      { id: 'womens', name: "Women's Haircut", duration: 60, price: '$55' },
    ];

    const hours = {
      1: { open: 12, close: 19 },
      2: { open: 9, close: 17.5 },
      3: { open: 9, close: 17 },
      4: { open: 11, close: 18 },
      5: { open: 9, close: 17 },
    };

    let state = { step: 1, service: null, date: null, time: null, details: {} };

    function renderServices() {
      const container = document.getElementById('services');
      container.innerHTML = services.map(s => `
        <button class="service-btn" data-id="${s.id}" style="text-align: left; padding: 1.15rem 1.25rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 12px; color: var(--text); cursor: pointer; transition: all 0.2s;">
          <strong style="display: block; font-size: 1.05rem;">${s.name}</strong>
          <span style="color: var(--muted); font-size: 0.85rem;">${s.duration} min · ${s.price}</span>
        </button>
      `).join('');
      container.querySelectorAll('.service-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.service = services.find(s => s.id === btn.dataset.id);
          nextStep();
        });
      });
    }

    function renderDates() {
      const container = document.getElementById('dates');
      const today = new Date();
      const dates = [];
      for (let i = 0; i < 14; i++) {
        const d = new Date(today);
        d.setDate(today.getDate() + i);
        const day = d.getDay();
        if (day === 0 || day === 6) continue;
        dates.push(d);
      }
      container.innerHTML = dates.map(d => {
        const key = d.toISOString().split('T')[0];
        const label = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
        return `<button class="date-btn" data-date="${key}" style="padding: 0.9rem 0.5rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; color: var(--text); cursor: pointer;">${label}</button>`;
      }).join('');
      container.querySelectorAll('.date-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.date = btn.dataset.date;
          nextStep();
        });
      });
    }

    function renderTimes() {
      const container = document.getElementById('times');
      const d = new Date(state.date);
      const day = d.getDay();
      const h = hours[day];
      if (!h) return;
      const slots = [];
      let t = h.open;
      while (t + (state.service.duration / 60) <= h.close) {
        const hour = Math.floor(t);
        const min = (t % 1) * 60;
        const label = `${hour > 12 ? hour - 12 : hour}:${min.toString().padStart(2, '0')} ${hour >= 12 ? 'PM' : 'AM'}`;
        slots.push({ time: t, label });
        t += 0.5;
      }
      container.innerHTML = slots.map(s => `
        <button class="time-btn" data-time="${s.time}" style="padding: 0.85rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; color: var(--text); cursor: pointer;">${s.label}</button>
      `).join('');
      container.querySelectorAll('.time-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.time = btn.dataset.time;
          nextStep();
        });
      });
    }

    function showStep(n) {
      document.querySelectorAll('.step').forEach(el => el.style.display = 'none');
      document.getElementById(`step-${n}`).style.display = 'block';
      document.querySelectorAll('#progress span').forEach(span => {
        span.style.color = span.dataset.step == n ? 'var(--accent)' : 'var(--muted)';
        span.style.fontWeight = span.dataset.step == n ? '600' : '400';
      });
      document.getElementById('back-btn').style.display = n > 1 && n < 5 ? 'inline-flex' : 'none';
    }

    function nextStep() {
      state.step++;
      if (state.step === 2) renderDates();
      if (state.step === 3) renderTimes();
      showStep(state.step);
    }

    document.getElementById('back-btn').addEventListener('click', () => {
      if (state.step > 1) {
        state.step--;
        showStep(state.step);
      }
    });

    document.getElementById('details-form').addEventListener('submit', (e) => {
      e.preventDefault();
      state.details = {
        name: document.getElementById('name').value,
        phone: document.getElementById('phone').value,
        email: document.getElementById('email').value,
        notes: document.getElementById('notes').value,
      };
      const conf = document.getElementById('confirmation');
      const timeLabel = document.querySelector(`.time-btn[data-time="${state.time}"]`)?.textContent || state.time;
      conf.innerHTML = `
        <p><strong>Service:</strong> ${state.service.name}</p>
        <p><strong>Date:</strong> ${new Date(state.date).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}</p>
        <p><strong>Time:</strong> ${timeLabel}</p>
        <p><strong>Name:</strong> ${state.details.name}</p>
        <p><strong>Phone:</strong> ${state.details.phone}</p>
      `;
      state.step = 5;
      showStep(5);
      console.log('Booking submitted:', state);
    });

    renderServices();
    showStep(1);
  </script>

  <style>
    .service-btn:hover, .date-btn:hover, .time-btn:hover {
      border-color: var(--accent) !important;
      transform: translateY(-2px);
    }
  </style>
</Layout>