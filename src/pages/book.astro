---
// Rendered on demand: services, prices, durations, and hours come from Square (src/lib/catalog.ts). The CDN keeps it for a minute.
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/site';
import { getPublicMenu, hoursRows } from '../lib/catalog';
import { openStatus } from '../lib/open-status';

const menu = await getPublicMenu();
const hoursDisplay = hoursRows(menu.hours);
const todayDow = openStatus(menu.hours).dow;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
Astro.response.headers.set('CDN-Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');
const steps = ['Service', 'Date', 'Time', 'Details', 'Done'];
---

<Layout
  title="Book Appointment | Parker Modern Classic Hair, Calhoun GA"
  description="Book a haircut, beard, or combo with Ben at Parker Modern Classic Hair in Calhoun, Georgia. Pick a service, date, and time in under a minute."
>
  <Header />

  <main class="book">
    <div class="book-bg" aria-hidden="true"></div>
    <div class="wrap">
      <header class="book-head">
        <p class="kicker mask"><span>Book Online · Ben's Chair</span></p>
        <h1 class="display book-title">
          <span class="mask" style="--d:.05s"><span>Take a <span class="serif-i accent">seat.</span></span></span>
        </h1>
        <p class="lede" data-reveal style="--d:.3s">Pick a service, choose a time, lock it in. Under a minute. Rather talk? <a href={business.phoneHref}>Call or text {business.phone}</a>.</p>
      </header>

      <div class="book-grid">
        <div id="booking-app" class="panel" data-reveal style="--d:.35s">
          <!-- Progress -->
          <div class="progress" aria-label="Booking progress">
            <div class="progress-bar"><span id="progress-fill"></span></div>
            <ol id="progress">
              {steps.map((s, i) => (
                <li data-step={i + 1}>
                  <button type="button" class="pstep" data-go={i + 1} disabled>
                    <span class="pnum"><b>{i + 1}</b></span>
                    <span class="plabel">{s}</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>

          <div id="step-1" class="step" data-title="Choose a service">
            <h2 class="step-title display">Choose a <span class="serif-i accent">service</span></h2>
            {menu.mode !== 'square' && <p class="step-sub">Online booking is in request mode right now: pick a time and Ben confirms it personally.</p>}
            <div id="services" class="svc-grid" role="list"></div>
            <script is:inline type="application/json" id="menu-data" set:html={JSON.stringify({ mode: menu.mode, services: menu.services }).replace(/</g, '\\u003c')}></script>
          </div>

          <div id="step-2" class="step" hidden>
            <h2 class="step-title display">Pick a <span class="serif-i accent">day</span></h2>
            <div id="dates" class="date-grid"></div>
          </div>

          <div id="step-3" class="step" hidden>
            <h2 class="step-title display">Open <span class="serif-i accent">times</span></h2>
            <p id="time-context" class="step-sub"></p>
            <div id="times"></div>
          </div>

          <div id="step-4" class="step" hidden>
            <h2 class="step-title display">Your <span class="serif-i accent">details</span></h2>
            <form id="details-form" class="form" novalidate>
              <label class="field">
                <span>Full name</span>
                <input type="text" id="name" name="name" autocomplete="name" required placeholder="First and last" />
              </label>
              <label class="field">
                <span>Phone number</span>
                <input type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" required placeholder="(706) 555-0123" />
              </label>
              <label class="field">
                <span>Email <em>optional</em></span>
                <input type="email" id="email" name="email" autocomplete="email" placeholder="you@email.com" />
              </label>
              <label class="field">
                <span>Notes for Ben <em>optional</em></span>
                <textarea id="notes" name="notes" rows="3" placeholder="Fade height, beard shape, anything he should know"></textarea>
              </label>
              <label class="hp" aria-hidden="true">Website <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" /></label>
              <p id="form-error" class="form-error" role="alert" hidden></p>
              <button type="submit" id="submit-btn" class="btn btn-block">Request This Time <span class="arrow">→</span></button>
              <p class="form-fine">Ben gets your request right away. You'll see the status on the next screen.</p>
              <p class="form-fine form-legal">By booking you agree to our <a href="/terms">Terms</a>. We use your details only to handle your appointment: see our <a href="/privacy">Privacy Policy</a>.</p>
            </form>
          </div>

          <div id="step-5" class="step done" hidden>
            <div class="stamp" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            </div>
            <p class="done-status"><span id="status-pill" class="status-pill">Pending</span></p>
            <h2 id="done-title" class="step-title display">Request <span class="serif-i accent">received.</span></h2>
            <p id="done-sub" class="step-sub">Ben has your request and confirms every appointment personally. Want it faster? Text or call him below.</p>
            <div id="confirmation" class="stub"></div>
            <div class="done-actions">
              <a id="send-sms" class="btn btn-block" href="#">Text Ben <span class="arrow">→</span></a>
              <a id="send-email" class="btn btn-ghost btn-block" href="#">Email Instead</a>
              <a href={business.phoneHref} class="btn btn-ghost btn-block">Call {business.phone}</a>
            </div>
            <a href="/" class="back-home">← Back to home</a>
          </div>

          <div class="panel-foot">
            <button id="back-btn" type="button" class="btn btn-ghost btn-sm" hidden>← Back</button>
          </div>
        </div>

        <!-- Summary: parchment receipt -->
        <aside class="summary" data-reveal="right" style="--d:.45s" aria-live="polite">
          <div class="ticket">
            <div class="ticket-head">
              <span class="ticket-brand display">Parker</span>
              <span class="ticket-sub">Your appointment</span>
            </div>
            <dl class="ticket-lines">
              <div><dt>Service</dt><dd id="sum-service">Not selected</dd></div>
              <div><dt>Date</dt><dd id="sum-date">Not selected</dd></div>
              <div><dt>Time</dt><dd id="sum-time">Not selected</dd></div>
              <div><dt>Duration</dt><dd id="sum-duration">--</dd></div>
            </dl>
            <div class="ticket-total">
              <span>Total</span>
              <strong id="sum-price" class="display">$0</strong>
            </div>
            <div class="ticket-perf" aria-hidden="true"></div>
            <div class="ticket-info">
              <p class="ticket-label">Hours</p>
              <ul>
                {hoursDisplay.map((h) => (
                  <li class={[h.closed && 'closed', h.idx === todayDow && 'today'].filter(Boolean).join(' ')} data-day={h.idx}><span>{h.short}</span><span>{h.label}</span></li>
                ))}
              </ul>
              <a href={business.mapsHref} target="_blank" rel="noopener" class="ticket-addr">{business.street}, {business.city}, {business.region} {business.zip} ↗</a>
              <a href={business.phoneHref} class="ticket-addr">{business.phone}</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { business } from '../data/site';
  import type { PublicService as Service } from '../lib/catalog';

  type Slot = { time: string; label: string; startsAt: string };
  type State = { step: number; maxStep: number; service: Service | null; date: string | null; slot: Slot | null; details: Record<string, string> };

  const TZ = 'America/New_York';
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const pad = (n: number) => String(n).padStart(2, '0');
  // Date keys are shop-local (America/New_York) no matter where the visitor is.
  const todayKey = () => new Intl.DateTimeFormat('en-CA', { timeZone: TZ }).format(new Date());
  const keyDate = (k: string) => new Date(`${k}T12:00:00Z`);
  const fmtKey = (k: string, o: Intl.DateTimeFormatOptions) => keyDate(k).toLocaleDateString('en-US', { timeZone: 'UTC', ...o });
  const fmtDur = (m: number) => (m < 60 ? `${m} min` : m % 60 ? `${Math.floor(m / 60)} hr ${m % 60} min` : `${m / 60} hr`);
  // Square synced menu, rendered by the server. Ids map to Square service variations, so price and booking match.
  function readMenu(): { mode: string; services: Service[] } {
    try { return JSON.parse(document.getElementById('menu-data')?.textContent || '{}'); } catch { return { mode: 'offline', services: [] }; }
  }
  const longDate = (k: string) => fmtKey(k, { weekday: 'long', month: 'long', day: 'numeric' });

  async function getJSON(url: string) {
    const r = await fetch(url, { headers: { accept: 'application/json' } });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Could not load times right now.');
    return d;
  }

  function init() {
    const app = document.getElementById('booking-app');
    if (!app) return;

    const state: State = { step: 1, maxStep: 1, service: null, date: null, slot: null, details: {} };
    const services: Service[] = readMenu().services || [];
    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const loading = (msg: string) => `<p class="step-sub loading"><span class="spin" aria-hidden="true"></span>${msg}</p>`;
    const fallback = (msg: string) => `<div class="fallback"><p class="step-sub">${esc(msg)}</p><div class="row-btns"><a class="btn btn-sm" href="${business.smsHref}">Text Ben</a><a class="btn btn-ghost btn-sm" href="${business.phoneHref}">Call ${business.phone}</a></div></div>`;
    let token = 0;

    function updateSummary() {
      $('sum-service').textContent = state.service ? state.service.name : 'Not selected';
      $('sum-date').textContent = state.date ? fmtKey(state.date, { weekday: 'short', month: 'short', day: 'numeric' }) : 'Not selected';
      $('sum-time').textContent = state.slot ? state.slot.label : 'Not selected';
      $('sum-duration').textContent = state.service ? fmtDur(state.service.duration) : '--';
      $('sum-price').textContent = state.service ? state.service.price : '$0';
      document.querySelectorAll('.ticket-lines dd').forEach((dd) => dd.classList.toggle('set', dd.textContent !== 'Not selected' && dd.textContent !== '--'));
    }

    function renderServices() {
      const c = $('services');
      if (!services.length) {
        c.innerHTML = fallback('The online menu is updating right now. Text or call Ben and he will get you on the books.');
        return;
      }
      c.innerHTML = services
        .map(
          (s, i) => `
        <button type="button" class="opt svc-opt${state.service?.id === s.id ? ' is-sel' : ''}" data-id="${s.id}" role="listitem">
          <span class="opt-num">${pad(i + 1)}</span>
          <span class="opt-body">
            <span class="opt-name">${esc(s.name)}</span>
            ${s.desc ? `<span class="opt-desc">${esc(s.desc)}</span>` : ''}
          </span>
          <span class="opt-meta">
            <span class="opt-price">${esc(s.price)}</span>
            <span class="opt-time">${esc(s.time)}</span>
          </span>
        </button>`
        )
        .join('');
      c.querySelectorAll<HTMLButtonElement>('.svc-opt').forEach((b) =>
        b.addEventListener('click', () => {
          const svc = services.find((s) => s.id === b.dataset.id)!;
          if (state.service?.id !== svc.id) { state.date = null; state.slot = null; state.maxStep = 2; }
          state.service = svc;
          go(2);
        })
      );
    }

    async function renderDates() {
      const c = $('dates');
      if (!state.service) return;
      const my = ++token;
      c.innerHTML = loading('Checking Ben\'s calendar...');
      try {
        const d = await getJSON(`/api/availability?start=${todayKey()}&days=21&service=${encodeURIComponent(state.service.id)}`);
        if (my !== token) return;
        const list = (d.days as { date: string; count: number }[]).filter((x) => x.count > 0).slice(0, 14);
        const today = todayKey();
        c.innerHTML = list.length
          ? list
              .map(
                (x, i) => `<button type="button" class="opt date-opt${state.date === x.date ? ' is-sel' : ''}" data-date="${x.date}" style="--i:${i}">
            <span class="d-wk">${x.date === today ? 'Today' : fmtKey(x.date, { weekday: 'short' })}</span>
            <span class="d-num">${Number(x.date.slice(8))}</span>
            <span class="d-mo">${fmtKey(x.date, { month: 'short' })}</span>
            <span class="d-ct">${x.count} open</span>
          </button>`
              )
              .join('')
          : fallback('Ben is booked solid for the next few weeks online. Text or call and he will try to fit you in.');
        c.querySelectorAll<HTMLButtonElement>('.date-opt').forEach((b) =>
          b.addEventListener('click', () => {
            if (state.date !== b.dataset.date) { state.slot = null; state.maxStep = 3; }
            state.date = b.dataset.date!;
            go(3);
          })
        );
      } catch (e) {
        if (my === token) c.innerHTML = fallback((e as Error).message);
      }
    }

    async function renderTimes(note = '') {
      const c = $('times');
      if (!state.date || !state.service) return;
      $('time-context').textContent = `${longDate(state.date)} · ${state.service.name} · ${fmtDur(state.service.duration)}`;
      const my = ++token;
      c.innerHTML = loading('Loading open times...');
      try {
        const d = await getJSON(`/api/availability?date=${state.date}&service=${encodeURIComponent(state.service.id)}`);
        if (my !== token) return;
        const slots = d.slots as Slot[];
        const h = (s: Slot) => Number(s.time.slice(0, 2));
        const groups = [
          { label: 'Morning', items: slots.filter((s) => h(s) < 12) },
          { label: 'Afternoon', items: slots.filter((s) => h(s) >= 12 && h(s) < 17) },
          { label: 'Evening', items: slots.filter((s) => h(s) >= 17) },
        ].filter((g) => g.items.length);
        c.innerHTML =
          (note ? `<p class="form-error" role="alert" style="margin-bottom:1rem">${esc(note)}</p>` : '') +
          (groups.length
            ? groups
                .map(
                  (g) => `<div class="time-group"><p class="tg-label">${g.label}</p><div class="time-grid">${g.items
                    .map((s) => `<button type="button" class="opt time-opt${state.slot?.startsAt === s.startsAt ? ' is-sel' : ''}" data-at="${s.startsAt}">${esc(s.label)}</button>`)
                    .join('')}</div></div>`
                )
                .join('')
            : `<p class="step-sub">No open times left on this day. Pick another date.</p>`);
        c.querySelectorAll<HTMLButtonElement>('.time-opt').forEach((b) =>
          b.addEventListener('click', () => {
            state.slot = slots.find((s) => s.startsAt === b.dataset.at) || null;
            go(4);
          })
        );
      } catch (e) {
        if (my === token) c.innerHTML = fallback((e as Error).message);
      }
    }

    function showStep(n: number) {
      document.querySelectorAll<HTMLElement>('#booking-app .step').forEach((el) => (el.hidden = true));
      const cur = $(`step-${n}`);
      cur.hidden = false;
      cur.classList.remove('enter');
      void cur.offsetWidth;
      cur.classList.add('enter');
      $('progress-fill').style.width = `${((n - 1) / 4) * 100}%`;
      document.querySelectorAll<HTMLLIElement>('#progress li').forEach((li) => {
        const s = Number(li.dataset.step);
        li.classList.toggle('is-cur', s === n);
        li.classList.toggle('is-done', s < n || (s <= state.maxStep && s !== n && n < 5));
        const btn = li.querySelector('button')!;
        btn.disabled = n === 5 || s > state.maxStep || s === n || s === 5;
        if (s === n) btn.setAttribute('aria-current', 'step'); else btn.removeAttribute('aria-current');
      });
      $('back-btn').hidden = !(n > 1 && n < 5);
      updateSummary();
    }

    function go(n: number, note = '') {
      state.step = n;
      state.maxStep = Math.max(state.maxStep, n);
      if (n === 1) renderServices();
      if (n === 2) renderDates();
      if (n === 3) renderTimes(note);
      showStep(n);
      const top = app!.getBoundingClientRect().top + window.scrollY - 90;
      if (window.scrollY > top) window.scrollTo({ top, behavior: 'smooth' });
    }

    $('back-btn').addEventListener('click', () => { if (state.step > 1) go(state.step - 1); });
    document.querySelectorAll<HTMLButtonElement>('.pstep').forEach((b) =>
      b.addEventListener('click', () => { const n = Number(b.dataset.go); if (n <= state.maxStep) go(n); })
    );

    let sending = false;
    $<HTMLFormElement>('details-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      const name = $<HTMLInputElement>('name').value.trim();
      const phone = $<HTMLInputElement>('phone').value.trim();
      const email = $<HTMLInputElement>('email').value.trim();
      const notes = $<HTMLTextAreaElement>('notes').value.trim();
      const website = $<HTMLInputElement>('website').value;
      const err = $('form-error');
      const digits = phone.replace(/\D/g, '').replace(/^1(?=\d{10}$)/, '');
      let msg = '';
      if (!name) msg = 'Add your name so Ben knows who is coming in.';
      else if (digits.length !== 10) msg = 'Add a 10 digit phone number Ben can reach you at.';
      else if (email && !/^\S+@\S+\.\S+$/.test(email)) msg = 'That email does not look right.';
      document.querySelectorAll('.field').forEach((f) => f.classList.remove('bad'));
      if (msg) {
        err.textContent = msg;
        err.hidden = false;
        (!name ? $('name') : digits.length !== 10 ? $('phone') : $('email')).closest('.field')!.classList.add('bad');
        return;
      }
      err.hidden = true;
      state.details = { name, phone, email, notes };
      const svc = state.service!;
      const slot = state.slot!;
      const btn = $<HTMLButtonElement>('submit-btn');
      const label = btn.innerHTML;
      sending = true;
      btn.disabled = true;
      btn.textContent = 'Sending...';

      let res: Response | null = null;
      let data: any = {};
      try {
        res = await fetch('/api/bookings', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ service: svc.id, date: state.date, time: slot.time, name, phone, email, notes, website }),
        });
        data = await res.json().catch(() => ({}));
      } catch {
        data = { error: 'Could not reach the booking system. Text or call Ben instead.' };
      }
      sending = false;
      btn.disabled = false;
      btn.innerHTML = label;

      if (res?.status === 409) {
        state.slot = null;
        go(3, data.error || 'That time was just taken. Pick another one.');
        return;
      }
      if (!res?.ok || !data.ok) {
        err.innerHTML = `${esc(data.error || 'Something went wrong.')} You can also <a href="${business.smsHref}">text</a> or <a href="${business.phoneHref}">call ${business.phone}</a>.`;
        err.hidden = false;
        return;
      }

      const confirmed = data.status === 'confirmed';
      const pill = $('status-pill');
      pill.textContent = confirmed ? 'Confirmed' : 'Pending confirmation';
      pill.classList.toggle('ok', confirmed);
      $('done-title').innerHTML = confirmed ? `You're <span class="serif-i accent">booked.</span>` : `Request <span class="serif-i accent">received.</span>`;
      $('done-sub').textContent = confirmed
        ? `You're on Ben's calendar.${email ? ' A confirmation is on its way to your email.' : ''} Need to change it? Text or call.`
        : `Ben has your request and will confirm it personally${email ? ' by email' : ''}. Want it faster? Text or call him below.`;

      const when = `${longDate(state.date!)} at ${slot.label}`;
      $('confirmation').innerHTML = `
        <div class="stub-row"><span>Status</span><strong>${confirmed ? 'Confirmed' : 'Waiting on Ben'}</strong></div>
        <div class="stub-row"><span>Service</span><strong>${esc(svc.name)}</strong></div>
        <div class="stub-row"><span>When</span><strong>${esc(when)}</strong></div>
        <div class="stub-row"><span>Length</span><strong>${fmtDur(svc.duration)}</strong></div>
        <div class="stub-row"><span>Name</span><strong>${esc(name)}</strong></div>
        <div class="stub-row"><span>Phone</span><strong>${esc(phone)}</strong></div>
        <div class="stub-row total"><span>Total</span><strong>${svc.price}</strong></div>`;

      const text = `Hi Ben, it's ${name}. I just ${confirmed ? 'booked' : 'requested'} a ${svc.name} on ${when} through the website. Phone: ${phone}.${notes ? ' Notes: ' + notes : ''}`;
      $<HTMLAnchorElement>('send-sms').href = `${business.smsHref}?&body=${encodeURIComponent(text)}`;
      $<HTMLAnchorElement>('send-email').href = `mailto:${business.email}?subject=${encodeURIComponent((confirmed ? 'Booked: ' : 'Booking request: ') + svc.name + ', ' + when)}&body=${encodeURIComponent(text + (email ? '\nEmail: ' + email : ''))}`;
      go(5);
    });

    // Deep link: /book?service=mens
    const pre = new URLSearchParams(location.search).get('service');
    const found = services.find((s) => s.id === pre);
    if (found) {
      state.service = found;
      go(2);
    } else {
      renderServices();
      showStep(1);
    }
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .book { position: relative; padding: calc(var(--header-h) + clamp(2.5rem, 6vw, 4.5rem)) 0 clamp(4rem, 8vw, 7rem); min-height: 100vh; isolation: isolate; overflow: hidden; }
  .book-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse 60% 50% at 90% 0%, rgba(197, 106, 58, 0.2), transparent 70%),
      radial-gradient(ellipse 60% 60% at 0% 100%, rgba(36, 54, 44, 0.9), transparent 70%),
      var(--forest-0);
  }
  .book-head { margin-bottom: clamp(2rem, 4vw, 3.25rem); }
  .book-title { font-size: clamp(3.4rem, 9vw, 7.4rem); line-height: 0.95; letter-spacing: -0.03em; margin: 1rem 0 1.2rem; }
  .book-head .lede a { color: var(--copper-hi); border-bottom: 1px solid var(--rule-2); white-space: nowrap; }

  .book-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(1.5rem, 3vw, 2.5rem); align-items: start; }

  .panel { background: rgba(21, 32, 25, 0.88); border: 1px solid var(--rule); border-radius: 20px; padding: clamp(1.25rem, 3.5vw, 2.6rem); position: relative; box-shadow: 0 40px 80px -50px rgba(0, 0, 0, 0.9); }

  /* Progress */
  .progress { margin-bottom: clamp(2rem, 4vw, 2.75rem); position: relative; }
  .progress-bar { position: absolute; left: 18px; right: 18px; top: 17px; height: 2px; border-radius: 2px; background: var(--rule); }
  .progress-bar span { position: absolute; left: 0; top: 0; height: 2px; width: 0; border-radius: 2px; background: linear-gradient(90deg, var(--copper-lo), var(--copper), var(--copper-hi)); transition: width 0.6s var(--ease); }
  #progress { list-style: none; display: flex; justify-content: space-between; position: relative; }
  .pstep { background: none; border: 0; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; cursor: pointer; padding: 0; }
  .pstep:disabled { cursor: default; }
  .pnum {
    width: 36px; height: 36px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--forest-0);
    border: 1px solid var(--rule);
