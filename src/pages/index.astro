---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <header style="position: fixed; inset: 0 0 auto 0; z-index: 50; background: rgba(7,7,7,0.8); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.05);">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between; height: 72px;">
      <a href="/" style="display: flex; align-items: center;">
        <img src="/logo-white.png" alt="Parker" style="height: 32px; width: auto;" />
      </a>
      <nav style="display: flex; gap: 2.5rem; font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase;">
        <a href="#services">Services</a>
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#reviews">Reviews</a>
      </nav>
      <a href="/book" class="btn" style="padding: 0.7rem 1.5rem; font-size: 0.7rem;">Book</a>
    </div>
  </header>

  <!-- Hero -->
  <section style="min-height: 100vh; display: flex; align-items: center; position: relative; overflow: hidden; padding-top: 72px;">
    <div style="position: absolute; inset: 0; background: radial-gradient(ellipse at 75% 45%, rgba(201,162,39,0.07) 0%, transparent 55%), #070707;"></div>
    <div class="container" style="position: relative; z-index: 2; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 5rem; align-items: center;">
      <div>
        <p style="color: var(--accent); letter-spacing: 0.3em; font-size: 0.72rem; text-transform: uppercase; margin-bottom: 1.5rem;">Calhoun, Georgia</p>
        <h1 style="font-size: clamp(4.5rem, 8.5vw, 8rem); margin-bottom: 1.75rem; line-height: 0.92;">
          Modern<br />Classic<br /><span style="color: var(--accent);">Hair</span>
        </h1>
        <p style="font-size: 1.2rem; max-width: 420px; color: #d4cfc6; margin-bottom: 2.75rem; line-height: 1.6;">
          Precision fades. Sharp beard work. Quiet confidence in every cut. Ben’s chair in downtown Calhoun.
        </p>
        <div style="display: flex; gap: 1rem;">
          <a href="/book" class="btn">Book Your Cut</a>
          <a href="#work" class="btn btn-outline">See the Work</a>
        </div>
      </div>
      <div style="aspect-ratio: 4/5; background: linear-gradient(160deg, #1a1a1a, #0d0d0d); border-radius: 18px; position: relative; overflow: hidden; border: 1px solid var(--border);">
        <div style="position: absolute; inset: 0; background: url('https://images.unsplash.com/photo-1599351431202-1e0f0137899a?auto=format&fit=crop&w=900&q=80') center/cover; opacity: 0.5; filter: grayscale(35%) contrast(1.15);"></div>
        <div style="position: absolute; bottom: 1.75rem; left: 1.75rem; right: 1.75rem; background: rgba(7,7,7,0.75); backdrop-filter: blur(14px); padding: 1.1rem 1.4rem; border-radius: 14px; border: 1px solid rgba(255,255,255,0.06);">
          <p style="font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);">Now Booking</p>
          <p style="font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; margin-top: 0.2rem;">Clean lines. Perfect fades.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" style="background: var(--surface);">
    <div class="container">
      <div style="text-align: center; max-width: 520px; margin: 0 auto 4.5rem;">
        <p style="color: var(--accent); letter-spacing: 0.24em; font-size: 0.72rem; text-transform: uppercase; margin-bottom: 0.75rem;">The Menu</p>
        <h2 style="font-size: clamp(3rem, 5.5vw, 4.5rem);">Services</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem;">
        {
          [
            { name: "Men’s Haircut", desc: "A precise, detailed, clipper haircut. Complimentary wash and style if requested.", time: "30 min", price: "$38" },
            { name: "Beard", desc: "Groom, straight razor, and detail beard.", time: "30 min", price: "$25" },
            { name: "Men’s Haircut & Beard", desc: "Combine services.", time: "1 hr", price: "$55" },
            { name: "Kid's Haircut", desc: "A precise, detailed, clipper haircut. Complimentary wash and style if requested. Age 15 and under.", time: "30 min", price: "$35" },
            { name: "Women's Haircut", desc: "Wash, cut, and blow dry.", time: "1 hr", price: "$55" },
          ].map(s => (
            <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: 16px; padding: 1.85rem; transition: border-color 0.25s, transform 0.25s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
              <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.65rem;">
                <p style="color: var(--accent); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;">{s.time}</p>
                <p style="font-family: 'Cormorant Garamond', serif; font-size: 1.75rem; color: var(--text);">{s.price}</p>
              </div>
              <h3 style="font-size: 1.65rem; margin-bottom: 0.65rem;">{s.name}</h3>
              <p style="color: var(--muted); font-size: 0.95rem; line-height: 1.55;">{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Work -->
  <section id="work">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.75rem;">
        <div>
          <p style="color: var(--accent); letter-spacing: 0.24em; font-size: 0.72rem; text-transform: uppercase; margin-bottom: 0.5rem;">The Chair</p>
          <h2 style="font-size: clamp(3rem, 5.5vw, 4.5rem);">Recent Work</h2>
        </div>
        <a href="/book" class="btn btn-outline">Book a Cut</a>
      </div>
      <div style="display: grid; grid-template-columns: 1.5fr 1fr 1fr; grid-template-rows: 300px 300px; gap: 0.85rem;">
        <div style="grid-row: 1 / 3; background: url('https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=900&q=80') center/cover; border-radius: 16px;"></div>
        <div style="background: url('https://images.unsplash.com/photo-1595476108010-b4d1f102b1b1?auto=format&fit=crop&w=700&q=80') center/cover; border-radius: 16px;"></div>
        <div style="background: url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=700&q=80') center/cover; border-radius: 16px;"></div>
        <div style="background: url('https://images.unsplash.com/photo-1622287162716-f311baa1a2b8?auto=format&fit=crop&w=700&q=80') center/cover; border-radius: 16px;"></div>
        <div style="background: url('https://images.unsplash.com/photo-1585747860715-2ba37e788b70?auto=format&fit=crop&w=700&q=80') center/cover; border-radius: 16px;"></div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" style="background: var(--surface);">
    <div class="container" style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 5rem; align-items: center;">
      <div>
        <p style="color: var(--accent); letter-spacing: 0.24em; font-size: 0.72rem; text-transform: uppercase; margin-bottom: 0.75rem;">The Barber</p>
        <h2 style="font-size: clamp(3rem, 5.5vw, 4.2rem); margin-bottom: 1.5rem;">Meet Ben</h2>
        <p style="margin-bottom: 1.1rem; color: #d4cfc6; font-size: 1.05rem;">Parker Modern Classic Hair is Ben’s chair. He listens, then executes with precision. Clients come for the fade and stay for the consistency.</p>
        <p style="margin-bottom: 1.5rem; color: #d4cfc6; font-size: 1.05rem;">Known for clean lines, patience (especially with kids), and making every client look and feel sharper than when they sat down.</p>
        <p style="color: var(--muted);">Classic neighborhood shop. Modern standards.</p>
      </div>
      <div style="aspect-ratio: 1; border-radius: 18px; overflow: hidden; border: 1px solid var(--border);">
        <img src="/ben-headshot.jpg" alt="Ben" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section id="reviews">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3.75rem;">
        <p style="color: var(--accent); letter-spacing: 0.24em; font-size: 0.72rem; text-transform: uppercase; margin-bottom: 0.5rem;">5.0 · 28+ Reviews</p>
        <h2 style="font-size: clamp(3rem, 5.5vw, 4.5rem);">What Clients Say</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem;">
        {
          [
            { quote: "Ben has been cutting my hair for over a year and I could not ask for a better barber. He understands the look and delivers.", name: "Jordan Stone" },
            { quote: "Took his time to listen and executed it exactly how I wanted. Efficient and detailed. 10/10.", name: "Kotaro Goto" },
            { quote: "Highly recommend Ben for any haircut or beard trim. Had me looking like a million dollars.", name: "Donnie Carter" },
          ].map(r => (
            <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 2rem;">
              <p style="font-size: 1.05rem; font-style: italic; margin-bottom: 1.35rem; color: #e8e2d8; line-height: 1.6;">"{r.quote}"</p>
              <p style="color: var(--accent); font-size: 0.9rem;">— {r.name}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA + Hours -->
  <section style="background: var(--surface); padding-bottom: 8rem;">
    <div class="container" style="text-align: center;">
      <h2 style="font-size: clamp(3.2rem, 6vw, 4.8rem); margin-bottom: 1rem;">Ready for the Chair?</h2>
      <p style="color: var(--muted); margin-bottom: 2.75rem; max-width: 460px; margin-left: auto; margin-right: auto; font-size: 1.05rem;">
        Book online in under a minute. Walk-ins welcome when the chair is open.
      </p>
      <a href="/book" class="btn" style="font-size: 0.85rem; padding: 1.05rem 2.4rem;">Book Appointment</a>

      <div style="margin: 4.5rem auto 0; max-width: 480px; background: var(--surface-2); border: 1px solid var(--border); border-radius: 18px; padding: 2.25rem 2.5rem; text-align: left;">
        <div style="display: grid; gap: 0.45rem; font-size: 1.02rem;">
          <p><strong>Monday</strong> <span style="float: right; color: var(--muted);">12–7 PM</span></p>
          <p><strong>Tuesday</strong> <span style="float: right; color: var(--muted);">9–5:30 PM</span></p>
          <p><strong>Wednesday</strong> <span style="float: right; color: var(--muted);">9–5 PM</span></p>
          <p><strong>Thursday</strong> <span style="float: right; color: var(--muted);">11–6 PM</span></p>
          <p><strong>Friday</strong> <span style="float: right; color: var(--muted);">9–5 PM</span></p>
          <p style="margin-top: 0.6rem; color: var(--muted);"><strong>Saturday & Sunday</strong> <span style="float: right;">Closed</span></p>
        </div>
        <div style="margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border); font-size: 0.95rem; line-height: 1.7;">
          <p>111 S Wall St Ste B<br />Calhoun, GA 30701</p>
          <p style="margin-top: 0.6rem;"><a href="tel:7064039150" style="color: var(--accent);">(706) 403-9150</a></p>
          <p><a href="mailto:benjamin3241959@yahoo.com" style="color: var(--accent);">benjamin3241959@yahoo.com</a></p>
        </div>
      </div>
    </div>
  </section>

  <footer style="padding: 3.5rem 0; border-top: 1px solid var(--border); text-align: center; color: var(--muted); font-size: 0.9rem;">
    <div class="container">
      <p style="font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; color: var(--text); margin-bottom: 0.5rem;">Parker Modern Classic Hair</p>
      <p>111 S Wall St Ste B · Calhoun, Georgia</p>
      <p style="margin-top: 0.65rem;"><a href="tel:7064039150">(706) 403-9150</a> · <a href="mailto:benjamin3241959@yahoo.com">benjamin3241959@yahoo.com</a></p>
    </div>
  </footer>
</Layout>