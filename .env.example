# Copy to .env for local dev (never commit .env). Set the same keys in Vercel > Project > Settings > Environment Variables.

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Long random string used to sign admin sessions. Generate: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string
# First admin login. `npm run seed` (or the first login attempt) creates it if no admin exists yet.
ADMIN_EMAIL=ben@example.com
ADMIN_PASSWORD=change-me-at-least-10-chars
ADMIN_NAME=Ben
# Public origin, used in email links. No trailing slash.
PUBLIC_SITE_URL=https://parkermodernclassichair.com

# --- Email (Resend). Without RESEND_API_KEY, emails are logged and bookings still work. ---
RESEND_API_KEY=
# Use onboarding@resend.dev until parkermodernclassichair.com is verified in Resend.
RESEND_FROM=Parker Modern Classic Hair <onboarding@resend.dev>
# Where new booking alerts go. Defaults to ADMIN_EMAIL.
ADMIN_NOTIFY_EMAIL=

# --- Square Appointments (source of truth when connected) ---
# sandbox or production
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Optional. Defaults to <origin>/api/admin/square/callback
SQUARE_REDIRECT_URI=
# Optional, for Sandbox testing without OAuth: a personal access token from the Square Developer Dashboard.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_TEAM_MEMBER_ID=
# true only if Ben is on Square Appointments Plus or Premium (unlocks seller-level writes).
SQUARE_SELLER_LEVEL_WRITES=false

# --- Google Calendar (optional secondary calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <origin>/api/admin/google/callback
GOOGLE_REDIRECT_URI=

# --- Vercel Cron: daily Square sync. Vercel sends it as a Bearer token. ---
CRON_SECRET=replace-with-a-random-string
