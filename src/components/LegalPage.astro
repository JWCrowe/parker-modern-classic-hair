---
// Shared shell for /privacy and /terms: same header, footer, and forest and copper look as the rest of the site.
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description: string;
  kicker: string;
  lead: string;
  accent: string;
  updated: string;
}
const { title, description, kicker, lead, accent, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <Header />
  <main class="legal">
    <div class="wrap">
      <header class="legal-head">
        <p class="kicker">{kicker}</p>
        <h1 class="display legal-title">{lead} <span class="serif-i accent">{accent}</span></h1>
        <p class="legal-updated">Last updated {updated}</p>
      </header>
      <article class="legal-body">
        <slot />
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal { padding: calc(var(--header-h) + clamp(3rem, 8vw, 6rem)) 0 clamp(4rem, 9vw, 7rem); background-image: radial-gradient(ellipse at 100% 0%, rgba(197, 106, 58, 0.1), transparent 45%); }
  .legal-head { max-width: 52rem; border-bottom: 1px solid var(--rule); padding-bottom: 2rem; margin-bottom: 2.5rem; }
  .legal-title { font-size: clamp(2.8rem, 8vw, 5.6rem); margin-top: 1rem; }
  .legal-updated { margin-top: 1.25rem; font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--moss); }
  .legal-body { max-width: 46rem; color: var(--bone-2); font-size: 1.02rem; line-height: 1.75; }
  .legal-body :global(h2) {
    font-family: var(--head);
    font-weight: 600;
    color: var(--bone);
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    line-height: 1.1;
    margin: 2.75rem 0 0.9rem;
  }
  .legal-body :global(h2:first-child) { margin-top: 0; }
  .legal-body :global(p) { margin: 0 0 1rem; }
  .legal-body :global(ul) { margin: 0 0 1.1rem 1.2rem; display: grid; gap: 0.45rem; }
  .legal-body :global(li::marker) { color: var(--copper); }
  .legal-body :global(strong) { color: var(--bone); font-weight: 600; }
  .legal-body :global(a) { color: var(--copper-hi); border-bottom: 1px solid var(--rule-2); transition: color 0.2s, border-color 0.2s; word-break: break-word; }
  .legal-body :global(a:hover) { color: var(--bone); border-color: var(--copper-hi); }
  .legal-body :global(.legal-card) { border: 1px solid var(--rule); border-radius: var(--radius); background: var(--forest-1); padding: 1.25rem 1.4rem; margin: 0.5rem 0 1.25rem; }
  .legal-body :global(.legal-card p) { margin: 0; }
  .legal-body :global(.legal-note) { font-size: 0.88rem; color: var(--moss); border-top: 1px solid var(--rule); padding-top: 1.5rem; margin-top: 3rem; }
</style>
