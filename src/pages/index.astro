---
// Rendered on demand so the menu and hours always come from Square (see src/lib/catalog.ts). The CDN keeps it for a minute.
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';
import { business, reviews, gallery, heroImage, floorImage } from '../data/site';
import { getPublicMenu, hoursRows } from '../lib/catalog';
import { openStatus } from '../lib/open-status';

const menu = await getPublicMenu();
const services = menu.services;
const hoursDisplay = hoursRows(menu.hours);
const status = openStatus(menu.hours);
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
Astro.response.headers.set('CDN-Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');

const star = '<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg>';
const stars = star.repeat(5);
---

<Layout>
  <Header home />

  <main>
    <!-- ======================= HERO ======================= -->
    <section class="hero" aria-label="Parker Modern Classic Hair">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="kicker mask"><span>Est. {business.est} · Downtown Calhoun, GA</span></p>
          <h1 class="hero-title display">
            <span class="mask" style="--d:.05s"><span>Sit down.</span></span>
            <span class="mask" style="--d:.18s"><span class="serif-i accent">Leave sharp.</span></span>
          </h1>
          <p class="hero-sub" data-reveal style="--d:.4s">
            Precision fades, straight razor beard work, and classic cuts from Ben, who listens first and takes his time.
            {business.street}, {business.city}.
          </p>
          <div class="hero-actions" data-reveal style="--d:.5s">
            <a href="/book" class="btn">Book Your Cut <span class="arrow">→</span></a>
            <a href="#services" class="btn btn-ghost">See the Menu</a>
          </div>
          <a href="#reviews" class="hero-rating" data-reveal style="--d:.6s">
            <span class="stars" set:html={stars} />
            <span><strong>{business.rating}</strong> from {business.reviewCount} client reviews</span>
          </a>
        </div>

        <div class="hero-visual" data-reveal="right" style="--d:.2s">
          <div class="arch">
            <img src={heroImage} alt="" fetchpriority="high" />
          </div>
          <div class="seal" aria-hidden="true">
            <svg viewBox="0 0 200 200">
              <defs><path id="sealPath" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
              <text><textPath href="#sealPath" textLength="486" lengthAdjust="spacing">PARKER · MODERN CLASSIC HAIR · CALHOUN · EST. {business.est} ·</textPath></text>
            </svg>
            <span class="seal-core">P</span>
          </div>
          <div class="hero-today" id="today-hours" data-hours={JSON.stringify(menu.hours)}>
            <span class="pulse" aria-hidden="true"></span>
            <span class="muted">Today at the shop</span>
            <strong>{status.msg}</strong>
          </div>
        </div>
      </div>

      <div class="wrap">
        <div class="hero-rail">
          <a href={business.mapsHref} target="_blank" rel="noopener"><span class="muted">Find us</span>{business.street}, {business.city}</a>
          <a href={business.phoneHref}><span class="muted">Call or text</span>{business.phone}</a>
          <a href="/book" class="rail-book"><span class="muted">Online</span>Book in under a minute →</a>
        </div>
      </div>
    </section>

    <Marquee />

    <!-- ======================= SERVICES ======================= -->
    <section id="services" class="section services">
      <div class="wrap">
        <div class="sec-head center">
          <p class="kicker" data-reveal>The Menu</p>
          <h2 class="h2">
            <span class="mask"><span>Services &amp; <span class="serif-i">prices.</span></span></span>
          </h2>
          <p class="lede" data-reveal style="--d:.15s">
            Straight prices. No upsell. Every cut is precise and detailed, with a complimentary wash and style if you want it.
          </p>
        </div>

        <div class="menu-card" data-reveal="scale">
          <div class="menu-head">
            <span>Parker</span>
            <span class="menu-title display">Service <span class="serif-i">Menu</span></span>
            <span>Est. {business.est}</span>
          </div>
          <ol class="menu-list">
            {services.length === 0 && (
              <li class="item item-empty">
                <a href={business.smsHref} class="item-link">
                  <span class="item-row"><span class="item-name">Text or call Ben</span></span>
                  <span class="item-desc">The online menu is updating. Ben can tell you prices and fit you in.</span>
                </a>
              </li>
            )}
            {services.map((s, i) => (
              <li class="item" data-reveal style={`--d:${0.04 * i}s`}>
                <a href={`/book?service=${s.id}`} class="item-link" aria-label={`Book ${s.name}, ${s.price}, ${s.time}`}>
                  <span class="item-row">
                    <span class="item-name">{s.name}</span>
                    <span class="item-leader" aria-hidden="true"></span>
                    <span class="item-price">{s.price}</span>
                  </span>
                  {s.desc && <span class="item-desc">{s.desc}</span>}
                  <span class="item-meta">
                    <span class="item-time">{s.time}</span>
                    <span class="item-go" aria-hidden="true">Book this →</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
          <div class="menu-foot">
            <span>Walk-ins welcome when the chair is open</span>
            <a href="/book" class="btn btn-sm">Book Online <span class="arrow">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================= HOW IT GOES ======================= -->
    <section class="section how" aria-label="How a visit goes">
      <div class="wrap">
        <div class="how-grid">
          <div class="how-intro">
            <p class="kicker" data-reveal>Your Visit</p>
            <h2 class="h2">
              <span class="mask"><span>Easy from</span></span>
              <span class="mask" style="--d:.1s"><span class="serif-i">start to finish.</span></span>
            </h2>
          </div>
          <ol class="how-steps">
            <li data-reveal>
              <span class="how-num serif-i">01</span>
              <h3>Book in a minute</h3>
              <p>Pick a service and a time online. Rather talk to a person? Call or text Ben.</p>
            </li>
            <li data-reveal style="--d:.1s">
              <span class="how-num serif-i">02</span>
              <h3>Talk it through</h3>
              <p>Ben listens first. Tell him the fade height, the length, the beard shape you want.</p>
            </li>
            <li data-reveal style="--d:.2s">
              <span class="how-num serif-i">03</span>
              <h3>Walk out sharp</h3>
              <p>Clean lines and a careful finish. Book the next one whenever you are ready.</p>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- ======================= WORK ======================= -->
    <section id="work" class="section work">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="kicker" data-reveal>The Craft</p>
            <h2 class="h2">
              <span class="mask"><span>Clean lines.</span></span>
              <span class="mask" style="--d:.1s"><span class="serif-i">No shortcuts.</span></span>
            </h2>
          </div>
          <div class="strip-ctrl" data-reveal style="--d:.15s">
            <button type="button" class="round" data-strip="-1" aria-label="Previous photos">←</button>
            <button type="button" class="round" data-strip="1" aria-label="Next photos">→</button>
          </div>
        </div>
      </div>
      <div class="strip" tabindex="0" aria-label="Photo gallery">
        {gallery.map((g, i) => (
          <figure class="shot" data-reveal style={`--d:${0.06 * i}s`}>
            <div class="shot-img"><img src={g.src} alt={g.label} loading="lazy" decoding="async" /></div>
            <figcaption>
              <span class="shot-num">No. {String(i + 1).padStart(2, '0')}</span>
              <span class="shot-label">{g.label}</span>
              <span class="shot-note">{g.note}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="wrap">
        <p class="gallery-note muted">Style reference imagery.</p>
      </div>
    </section>

    <Marquee dark reverse words={['Precision', 'Patience', 'Consistency', 'Straight Razor']} />

    <!-- ======================= ABOUT ======================= -->
    <section id="about" class="section about">
      <div class="wrap about-grid">
        <div class="about-photo" data-reveal="left">
          <div class="portrait">
            <img src="/ben-portrait.jpg" alt="Ben, barber and owner of Parker Modern Classic Hair" width="486" height="607" loading="lazy" />
          </div>
          <div class="plaque">
            <span class="plaque-name display">Ben Parker</span>
            <span class="plaque-role">Barber &amp; owner · Since {business.est}</span>
          </div>
        </div>

        <div class="about-copy">
          <p class="kicker" data-reveal>The Barber</p>
          <h2 class="h2">
            <span class="mask"><span>Meet</span></span>
            <span class="mask" style="--d:.1s"><span class="serif-i">Ben.</span></span>
          </h2>
          <div class="about-text" data-reveal style="--d:.15s">
            <p class="about-lead">Parker Modern Classic Hair is Ben's chair. He listens first, then executes with precision.</p>
            <p>Clients come for the fade and stay for the consistency. He is known for clean lines, patience (especially with kids), and sending every client out sharper than when they sat down.</p>
            <p class="muted">Classic neighborhood shop. Modern standards.</p>
          </div>
          <dl class="about-stats" data-reveal style="--d:.25s">
            <div><dt class="display">{business.rating}</dt><dd>Star rating</dd></div>
            <div><dt class="display">{business.reviewCount}</dt><dd>Client reviews</dd></div>
            <div><dt class="display">{business.est}</dt><dd>Established</dd></div>
          </dl>
          <a href="/book" class="btn" data-reveal style="--d:.3s">Sit in Ben's Chair <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- ======================= REVIEWS ======================= -->
    <section id="reviews" class="section reviews">
      <div class="wrap">
        <div class="rev-head">
          <div>
            <p class="kicker" data-reveal>Word on the Street</p>
            <h2 class="h2">
              <span class="mask"><span>Regulars <span class="serif-i">say it best.</span></span></span>
            </h2>
          </div>
          <div class="rev-score" data-reveal style="--d:.1s">
            <span class="display">{business.rating}</span>
            <div>
              <span class="stars" set:html={stars} />
              <p>{business.reviewCount} reviews</p>
            </div>
          </div>
        </div>

        <div class="rev-grid">
          {reviews.map((r, i) => (
            <blockquote class="rev" data-reveal style={`--d:${0.1 * i}s`}>
              <span class="rev-mark" aria-hidden="true">“</span>
              <p class="rev-q">{r.quote}</p>
              <footer>
                <span class="stars" set:html={stars} />
                <span class="rev-name">{r.name}</span>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================= VISIT / CTA ======================= -->
    <section id="visit" class="visit">
      <div class="visit-band">
        <img src={floorImage} alt="" loading="lazy" decoding="async" aria-hidden="true" />
        <div class="wrap visit-head">
          <p class="kicker" data-reveal>Ready When You Are</p>
          <h2 class="visit-title display">
            <span class="mask"><span>Your chair</span></span>
            <span class="mask" style="--d:.1s"><span class="serif-i accent">is waiting.</span></span>
          </h2>
          <div class="visit-actions" data-reveal style="--d:.2s">
            <a href="/book" class="btn">Book Appointment <span class="arrow">→</span></a>
            <a href={business.phoneHref} class="btn btn-ghost">Call {business.phone}</a>
          </div>
        </div>
      </div>

      <div class="wrap">
        <div class="visit-grid">
          <div class="hours-card" data-reveal>
            <p class="kicker plain">Hours</p>
            <ul class="hours">
              {hoursDisplay.map((h) => (
                <li data-day={h.idx} class={[h.closed && 'closed', h.idx === status.dow && 'today'].filter(Boolean).join(' ')}>
                  <span>{h.day}</span>
                  <span class="dots" aria-hidden="true"></span>
                  <span>{h.label}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="contact-card" data-reveal style="--d:.1s">
            <a href={business.mapsHref} target="_blank" rel="noopener" class="contact-row">
              <span class="kicker plain">Address</span>
              <span class="contact-val">{business.street}<br />{business.city}, {business.region} {business.zip}</span>
              <span class="contact-go">Open in Google Maps ↗</span>
            </a>
            <a href={business.phoneHref} class="contact-row">
              <span class="kicker plain">Phone</span>
              <span class="contact-val">{business.phone}</span>
              <span class="contact-go">Tap to call →</span>
            </a>
            <a href={`mailto:${business.email}`} class="contact-row">
              <span class="kicker plain">Email</span>
              <span class="contact-val email">{business.email}</span>
              <span class="contact-go">Send a note →</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Mobile sticky book bar -->
  <div class="sticky-book" role="region" aria-label="Quick booking">
    <a href={business.phoneHref} class="sb-call" aria-label={`Call ${business.phone}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"/></svg>
    </a>
    <a href="/book" class="btn sb-book">Book Now <span class="arrow">→</span></a>
  </div>
</Layout>

<script>
  import { openStatus } from '../lib/open-status';
  // Hours come from Square via the server render. Recompute here so a cached page still shows the right status.
  function initToday() {
    const el = document.getElementById('today-hours');
    if (!el) return;
    let hours = {};
    try { hours = JSON.parse(el.dataset.hours || '{}'); } catch {}
    const st = openStatus(hours);
    document.querySelectorAll('.hours li.today').forEach((li) => li.classList.remove('today'));
    document.querySelectorAll(`.hours li[data-day="${st.dow}"]`).forEach((li) => li.classList.add('today'));
    const strong = el.querySelector('strong');
    if (strong) strong.textContent = st.msg;
  }
  function initStrip() {
    const strip = document.querySelector<HTMLElement>('.strip');
    if (!strip) return;
    const step = () => (strip.querySelector<HTMLElement>('.shot')?.offsetWidth || 320) + 16;
    document.querySelectorAll<HTMLButtonElement>('[data-strip]').forEach((b) => {
      b.onclick = () => strip.scrollBy({ left: Number(b.dataset.strip) * step(), behavior: 'smooth' });
    });
  }
  document.addEventListener('astro:page-load', () => {
    initToday();
    initStrip();
  });
</script>

<style>
  /* ================= HERO ================= */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--header-h) + 2rem) 0 2rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--forest-0);
  }
  .hero-glow {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(ellipse 60% 70% at 78% 40%, rgba(197, 106, 58, 0.22), transparent 70%),
      radial-gradient(ellipse 70% 80% at 10% 100%, rgba(36, 54, 44, 0.85), transparent 70%),
      linear-gradient(180deg, var(--forest-0), var(--forest-1));
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    flex: 1;
  }
  .hero-title {
    font-size: clamp(3.6rem, min(10vw, 15vh), 9.6rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 1.4rem 0 1.6rem;
  }
  .hero-title .serif-i { font-weight: 500; padding-right: 0.06em; }
  .hero-sub { max-width: 32rem; font-size: clamp(1.04rem, 1.35vw, 1.2rem); font-weight: 300; color: var(--bone-2); margin-bottom: 2rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .hero-rating { display: inline-flex; align-items: center; gap: 0.8rem; margin-top: 2rem; font-size: 0.9rem; color: var(--moss); transition: color 0.2s; }
  .hero-rating strong { color: var(--bone); font-weight: 600; }
  .hero-rating:hover { color: var(--bone-2); }

  .hero-visual { position: relative; justify-self: end; width: min(100%, 520px); }
  .arch {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 18px 18px;
    overflow: hidden;
    background: var(--forest-2);
    box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.85), 0 0 0 1px var(--rule);
  }
  .arch::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(14, 22, 18, 0.05) 40%, rgba(14, 22, 18, 0.75) 100%), linear-gradient(0deg, rgba(28, 42, 34, 0.35), rgba(28, 42, 34, 0.35));
    mix-blend-mode: multiply;
  }
  .arch img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    filter: saturate(0.85) contrast(1.08) brightness(0.9) sepia(0.12);
    animation: slowpush 24s var(--ease) both;
  }
  @keyframes slowpush { from { transform: scale(1.14); } to { transform: scale(1.02); } }
  .hero-visual::before {
    content: '';
    position: absolute;
    inset: -14px -14px auto auto;
    width: 100%; height: 100%;
    border: 1px solid var(--rule-2);
    border-radius: 999px 999px 18px 18px;
    z-index: -1;
  }
  .seal {
    position: absolute;
    left: -3.2rem; top: 14%;
    width: 132px; height: 132px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--copper);
    color: var(--forest-0);
    box-shadow: 0 20px 40px -18px rgba(0, 0, 0, 0.8);
  }
  .seal svg { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 26s linear infinite; }
  .seal text { font-family: var(--sans); font-size: 12.5px; font-weight: 600; fill: currentColor; }
  .seal-core { font-family: var(--head); font-style: italic; font-weight: 600; font-size: 3rem; line-height: 1; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .hero-today {
    position: absolute;
    right: 1.25rem; bottom: 1.25rem; left: 1.25rem;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    background: rgba(14, 22, 18, 0.78);
    border: 1px solid var(--rule);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.95rem;
  }
  .hero-today .pulse { grid-row: span 2; width: 9px; height: 9px; border-radius: 50%; background: var(--copper-hi); animation: pulse 2.2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(224, 138, 88, 0.6); } 70% { box-shadow: 0 0 0 10px rgba(224, 138, 88, 0); } 100% { box-shadow: 0 0 0 0 rgba(224, 138, 88, 0); } }
  .hero-today :global(.muted) { font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; }
  .hero-today :global(strong) { font-weight: 500; color: var(--bone); }

  .hero-rail {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: rgba(21, 32, 25, 0.6);
    overflow: hidden;
  }
  .hero-rail a { display: grid; gap: 0.15rem; padding: 1.05rem 1.4rem; font-size: 0.95rem; color: var(--bone-2); transition: background 0.25s, color 0.25s; }
  .hero-rail a + a { border-left: 1px solid var(--rule); }
  .hero-rail a:hover { background: var(--forest-2); color: var(--bone); }
  .hero-rail .muted { font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; }
  .hero-rail .rail-book { color: var(--copper-hi); font-weight: 500; }

  /* ================= SECTION HEADS ================= */
  .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem 4rem; flex-wrap: wrap; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .sec-head.center { flex-direction: column; align-items: center; text-align: center; gap: 0; }
  .sec-head.center .lede { margin-top: 1.25rem; }

  /* ================= SERVICES: parchment menu card ================= */
  .services { background: var(--forest-1); }
  .menu-card {
    position: relative;
    max-width: 1040px;
    margin: 0 auto;
    background: var(--paper);
    background-image: radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.5), transparent 60%), radial-gradient(ellipse at 100% 100%, rgba(143, 74, 38, 0.1), transparent 55%);
    color: var(--paper-ink);
    border-radius: 6px;
    padding: clamp(1.5rem, 4.5vw, 3.75rem);
    box-shadow: 0 50px 90px -45px rgba(0, 0, 0, 0.9);
  }
  .menu-card::before { content: ''; position: absolute; inset: 10px; border: 1px solid var(--rule-paper); border-radius: 3px; pointer-events: none; }
  .menu-head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule-paper);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--moss-2);
  }
  .menu-head span:last-child { text-align: right; }
  .menu-title { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.01em; text-transform: none; color: var(--paper-ink); }
  .menu-title .serif-i { color: var(--copper-lo); }
  .menu-list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(2rem, 5vw, 4rem); }
  .item { border-bottom: 1px dashed var(--rule-paper); }
  .item-link { display: grid; gap: 0.4rem; padding: 1.35rem 0.25rem; border-radius: 6px; transition: background 0.3s, padding 0.3s var(--ease); }
  .item-link:hover { background: rgba(197, 106, 58, 0.08); padding-inline: 0.85rem; }
  .item-row { display: flex; align-items: baseline; gap: 0.75rem; }
