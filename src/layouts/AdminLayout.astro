---
import '../styles/global.css';
import '../styles/admin.css';
import { sql } from '../lib/db';

interface Props { title: string; active?: string; bare?: boolean }
const { title, active = '', bare = false } = Astro.props;
const admin = Astro.locals.admin;
let inquiries = 0;
if (admin && !bare) {
  try {
    inquiries = (await sql()`select count(*)::int as n from appointments where status = 'inquiry' and starts_at > now() - interval '1 day'`)[0].n;
  } catch {}
}
const nav = [
  { href: '/admin', key: 'dash', label: 'Dashboard' },
  { href: '/admin/calendar', key: 'calendar', label: 'Calendar' },
  { href: '/admin/inquiries', key: 'inquiries', label: 'Inquiries', badge: inquiries },
  { href: '/admin/appointments', key: 'appointments', label: 'Appointments' },
  { href: '/admin/clients', key: 'clients', label: 'Clients' },
  { href: '/admin/settings', key: 'settings', label: 'Settings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0908" />
    <title>{title} | Parker Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  </head>
  <body class="admin-body">
    {bare ? (
      <slot />
    ) : (
      <div class="admin-shell">
        <aside class="admin-side">
          <a href="/admin" class="brand" aria-label="Admin home"><img src="/logo-cream.png" alt="Parker" width="502" height="251" /></a>
          <p class="who">Signed in as {admin?.name || 'Ben'}</p>
          <nav class="admin-nav" aria-label="Admin">
            {nav.map((n) => (
              <a href={n.href} class={active === n.key ? 'is-cur' : ''}>
                {n.label}
                {n.badge ? <span class="badge">{n.badge}</span> : null}
              </a>
            ))}
          </nav>
          <div class="side-foot">
            <a href="/" target="_blank" rel="noopener">View site ↗</a>
            <button type="button" data-sign-out>Sign out</button>
          </div>
        </aside>
        <main class="admin-main">
          <slot />
        </main>
      </div>
    )}
    <script>
      import '../scripts/admin';
    </script>
  </body>
</html>
