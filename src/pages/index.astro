---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <header style="position: fixed; inset: 0 0 auto 0; z-index: 50; background: rgba(7,7,7,0.75); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(255,255,255,0.04);">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between; height: 72px;">
      <a href="/" style="font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; font-weight: 600; letter-spacing: 0.18em; color: var(--text);">PARKER</a>
      <nav style="display: flex; gap: 2.25rem; font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase;">
        <a href="#services">Services</a>
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#reviews">Reviews</a>
      </nav>
      <a href="/book" class="btn" style="padding: 0.65rem 1.4rem; font-size: 0.72rem;">Book</a>
    </div>
  </header>

  <!-- Hero -->
  <section style="min-height: 100vh; display: flex; align-items: center; position: relative; overflow: hidden; padding-top: 72px;">
    <div style="position: absolute; inset: 0; background: radial-gradient(ellipse at 70% 40%, rgba(201,162,39,0.08) 0%, transparent 50%), #070707;"></div>
    <div class="container" style="position: relative; z-index: 2; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center;">
      <div>
        <p style="color: var(--accent); letter-spacing: 0.28em; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 1.25rem;">Calhoun, Georgia</p>
        <h1 style="font-size: clamp(4.2rem, 8vw, 7.5rem); margin-bottom: 1.5rem;">
          Modern<br />Classic<br /><span style="color: var(--accent);">Hair</span>
        </h1>
        <p style="font-size: 1.15rem; max-width: 440px; color: #d4cfc6; margin-bottom: 2.5rem;">
          Precision fades. Sharp beard work. Quiet confidence in every cut. Ben’s chair in downtown Calhoun.
        </p>
        <div style="display: flex; gap: 1rem;">
          <a href="/book" class="btn">Book Your Cut</a>
          <a href="#work" class="btn btn-outline">See the Work</a>
        </div>
      </div>
      <div style="aspect-ratio: 4/5; background: linear-gradient(160deg, #1a1a1a, #0d0d0d); border-radius: 16px; position: relative; overflow: hidden; border: 1px solid var(--border);">
        <div style="position: absolute; inset: 0; background: url('https://images.unsplash.com/photo-1599351431202-1e0f0137899a?auto=format&fit=crop&w=900&q=80') center/cover; opacity: 0.55; filter: grayscale(40%) contrast(1.1);"></div>
        <div style="position: absolute; bottom: 1.5rem; left: 1.5rem; right: 1.5rem; background: rgba(7,7,7,0.7); backdrop-filter: blur(12px); padding: 1rem 1.25rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06);">
          <p style="font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent);">Now Booking</p>
          <p style="font-family: 'Cormorant Garamond', serif; font-size: 1.4rem;">Clean lines. Perfect fades.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" style="background: var(--surface);">
    <div class="container">
      <div style="text-align: center; max-width: 560px; margin: 0 auto 4.5rem;">
        <p style="color: var(--accent); letter-spacing: 0.22em; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.75rem;">The Menu</p>
        <h2 style="font-size: clamp(2.8rem, 5vw, 4.2rem);">Services</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {
          [
            { name: "Men’s Haircut", desc: "A precise, detailed, clipper haircut. Complimentary wash and style if requested.", time: "30 min", price: "$38" },
            { name: "Beard", desc: "Groom, straight razor, and detail beard.", time: "30 min", price: "$25" },
            { name: "Men’s Haircut & Beard", desc: "Combine services.", time: "1 hr", price: "$55" },
            { name: "Kid's Haircut", desc: "A precise, detailed, clipper haircut. Complimentary wash and style if requested. Age 15 and under.", time: "30 min", price: "$35" },
            { name: "Women's Haircut", desc: "Wash, cut, and blow dry.", time: "1 hr", price: "$55" },
          ].map(s => (
            <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: 14px; padding: 2rem; transition: border-color 0.25s, transform 0.25s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
              <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
                <p style="color: var(--accent); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;">{s.time}</p>
                <p style="font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; color: var(--text);">{s.price}</p>
              </div>
              <h3 style="font-size: 1.7rem; margin-bottom: 0.75rem;">{s.name}</h3>
              <p style="color: var(--muted); font-size: 0.95rem;">{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Work / Gallery -->
  <section id="work">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem;">
        <div>
          <p style="color: var(--accent); letter-spacing: 0.22em; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.5rem;">The Chair</p>
          <h2 style="font-size: clamp(2.8rem, 5vw, 4.2rem);">Recent Work</h2>
        </div>
        <a href="/book" class="btn btn-outline">Book a Cut</a>
      </div>
      <div style="display: grid; grid-template-columns: 1.4fr 1fr 1fr; grid-template-rows: 280px 280px; gap: 1rem;">
        <div style="grid-row: 1 / 3; background: url('https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=800&q=80') center/cover; border-radius: 14px;"></div>
        <div style="background: url('https://images.unsplash.com/photo-1595476108010-b4d1f102b1b1?auto=format&fit=crop&w=600&q=80') center/cover; border-radius: 14px;"></div>
        <div style="background: url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=600&q=80') center/cover; border-radius: 14px;"></div>
        <div style="background: url('https://images.unsplash.com/photo-1622287162716-f311baa1a2b8?auto=format&fit=crop&w=600&q=80') center/cover; border-radius: 14px;"></div>
        <div style="background: url('https://images.unsplash.com/photo-1585747860715-2ba37e788b70?auto=format&fit=crop&w=600&q=80') center/cover; border-radius: 14px;"></div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" style="background: var(--surface);">
    <div class="container" style="display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;">
      <div>
        <p style="color: var(--accent); letter-spacing: 0.22em; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.75rem;">The Barber</p>
        <h2 style="font-size: clamp(2.8rem, 5vw, 4rem); margin-bottom: 1.5rem;">Meet Ben</h2>
        <p style="margin-bottom: 1rem; color: #d4cfc6;">Parker Modern Classic Hair is Ben’s chair. He listens, then executes with precision. Clients come for the fade and stay for the consistency.</p>
        <p style="margin-bottom: 1.5rem; color: #d4cfc6;">Known for clean lines, patience (especially with kids), and making every client look and feel sharper than when they sat down.</p>
        <p style="color: var(--muted);">Classic neighborhood shop. Modern standards.</p>
      </div>
      <div style="aspect-ratio: 1; background: var(--surface-2); border-radius: 16px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border); font-size: 5rem;">✂️</div>
    </div>
  </section>

  <!-- Reviews -->
  <section id="reviews">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <p style="color: var(--accent); letter-spacing: 0.22em; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.5rem;">5.0 · 28+ Reviews</p>
        <h2 style="font-size: clamp(2.8rem, 5vw, 4.2rem);">What Clients Say</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
        {
          [
            { quote: "Ben has been cutting my hair for over a year and I could not ask for a better barber. He understands the look and delivers.", name: "Jordan Stone" },
            { quote: "Took his time to listen and executed it exactly how I wanted. Efficient and detailed. 10/10.", name: "Kotaro Goto" },
            { quote: "Highly recommend Ben for any haircut or beard trim. Had me looking like a million dollars.", name: "Donnie Carter" },
          ].map(r => (
            <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 2rem;">
              <p style="font-size: 1.05rem; font-style: italic; margin-bottom: 1.25rem; color: #e8e2d8;">"{r.quote}"</p>
              <p style="color: var(--accent); font-size: 0.9rem;">— {r.name}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Hours + CTA -->
  <section style="background: var(--surface); text-align: center;">
    <div class="container">
      <h2 style="font-size: clamp(2.8rem, 5vw, 4rem); margin-bottom: 1rem;">Ready for the Chair?</h2>
      <p style="color: var(--muted); margin-bottom: 2.5rem; max-width: 480px; margin-left: auto; margin-right: auto;">Book online in under a minute. Walk-ins welcome when the chair is open.</p>
      <a href="/book" class="btn" style="font-size: 0.9rem;">Book Appointment</a>
      <div style="margin-top: 3.5rem; display: inline-block; text-align: left; background: var(--surface-2); padding: 1.75rem 2.5rem; border-radius: 14px; border: 1px solid var(--border);">
        <p><strong>Mon</strong> 12–7 PM</p>
        <p><strong>Tue</strong> 9–5:30 PM</p>
        <p><strong>Wed</strong> 9–5 PM</p>
        <p><strong>Thu</strong> 11–6 PM</p>
        <p><strong>Fri</strong> 9–5 PM</p>
        <p style="margin-top: 0.75rem; color: var(--muted);">Sat & Sun Closed</p>
        <p style="margin-top: 1.25rem; font-size: 0.95rem;">111 S Wall St Ste B<br />Calhoun, GA 30701</p>
        <p style="margin-top: 0.75rem;"><a href="tel:7064039150" style="color: var(--accent);">(706) 403-9150</a></p>
        <p><a href="mailto:benjamin3241959@yahoo.com" style="color: var(--accent);">benjamin3241959@yahoo.com</a></p>
      </div>
    </div>
  </section>

  <footer style="padding: 3rem 0; border-top: 1px solid var(--border); text-align: center; color: var(--muted); font-size: 0.9rem;">
    <div class="container">
      <p style="font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; color: var(--text); margin-bottom: 0.5rem;">Parker Modern Classic Hair</p>
      <p>111 S Wall St Ste B · Calhoun, Georgia</p>
      <p style="margin-top: 0.5rem;"><a href="tel:7064039150">(706) 403-9150</a> · <a href="mailto:benjamin3241959@yahoo.com">benjamin3241959@yahoo.com</a></p>
    </div>
  </footer>
</Layout>