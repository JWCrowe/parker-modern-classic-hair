---
import { business } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-cta">
      <p class="footer-line display">See you in <span class="serif-i accent">the chair.</span></p>
      <a href="/book" class="btn">Book Online <span class="arrow">→</span></a>
    </div>

    <div class="footer-top">
      <a href="/" class="footer-brand" aria-label="Home">
        <img src="/logo-cream.png" alt="Parker Modern Classic Hair" width="502" height="251" loading="lazy" />
      </a>
      <div class="footer-cols">
        <div>
          <p class="kicker plain">Visit</p>
          <a href={business.mapsHref} target="_blank" rel="noopener">{business.street}<br />{business.city}, {business.region} {business.zip}</a>
        </div>
        <div>
          <p class="kicker plain">Contact</p>
          <a href={business.phoneHref}>{business.phone}</a>
          <a href={`mailto:${business.email}`} class="email">{business.email}</a>
        </div>
        <div>
          <p class="kicker plain">The Chair</p>
          <a href="/book">Book online</a>
          <a href="/#services">Services &amp; prices</a>
          <a href="/#visit">Hours</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {business.name}</p>
      <nav class="footer-legal" aria-label="Legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </nav>
      <p>Calhoun, Georgia · Est. {business.est}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--forest-0);
    background-image: radial-gradient(ellipse at 50% 0%, rgba(197, 106, 58, 0.12), transparent 60%);
    border-top: 1px solid var(--rule);
    padding: clamp(4rem, 8vw, 6rem) 0 calc(2rem + env(safe-area-inset-bottom));
    overflow: hidden;
  }
  .footer-cta { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem 3rem; flex-wrap: wrap; padding-bottom: clamp(2.5rem, 5vw, 4rem); margin-bottom: clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--rule); }
  .footer-line { font-size: clamp(2.4rem, 6vw, 4.6rem); }
  .footer-top { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; align-items: start; }
  .footer-brand img { width: 180px; height: auto; }
  .footer-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .footer-cols div { display: flex; flex-direction: column; gap: 0.5rem; }
  .footer-cols .kicker { margin-bottom: 0.4rem; color: var(--moss); }
  .footer-cols a { color: var(--bone-2); font-size: 0.98rem; transition: color 0.2s; }
  .footer-cols a:hover { color: var(--copper-hi); }
  .footer-cols .email { word-break: break-all; font-size: 0.9rem; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--rule); margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: 1.5rem; font-size: 0.78rem; letter-spacing: 0.08em; color: var(--moss); }
  .footer-legal { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .footer-legal a { color: var(--bone-2); transition: color 0.2s; }
  .footer-legal a:hover { color: var(--copper-hi); }
  @media (max-width: 820px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-cols { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .footer-cols { grid-template-columns: 1fr; }
    .footer-cta .btn { width: 100%; }
    .site-footer { padding-bottom: calc(6rem + env(safe-area-inset-bottom)); }
  }
</style>
