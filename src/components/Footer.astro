---
import { business } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <a href="/" class="footer-brand" aria-label="Home">
        <img src="/logo-cream.png" alt="Parker Modern Classic Hair" width="502" height="251" loading="lazy" />
      </a>
      <div class="footer-cols">
        <div>
          <p class="kicker plain">Visit</p>
          <a href={business.mapsHref} target="_blank" rel="noopener">{business.street}<br />{business.city}, {business.region} {business.zip}</a>
        </div>
        <div>
          <p class="kicker plain">Contact</p>
          <a href={business.phoneHref}>{business.phone}</a>
          <a href={`mailto:${business.email}`} class="email">{business.email}</a>
        </div>
        <div>
          <p class="kicker plain">Chair</p>
          <a href="/book">Book online</a>
          <a href="/#services">Services &amp; prices</a>
        </div>
      </div>
    </div>
    <div class="footer-word display" aria-hidden="true">Parker</div>
    <div class="footer-bottom">
      <p>© {year} {business.name}</p>
      <nav class="footer-legal" aria-label="Legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </nav>
      <p>Calhoun, Georgia · Est. {business.est}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; background: var(--ink); border-top: 1px solid var(--line); padding: 5rem 0 calc(2rem + env(safe-area-inset-bottom)); overflow: hidden; }
  .footer-top { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; align-items: start; }
  .footer-brand img { width: 190px; height: auto; }
  .footer-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .footer-cols div { display: flex; flex-direction: column; gap: 0.5rem; }
  .footer-cols .kicker { margin-bottom: 0.5rem; }
  .footer-cols a { color: var(--cream-2); font-size: 0.95rem; transition: color 0.2s; }
  .footer-cols a:hover { color: var(--brass); }
  .footer-cols .email { word-break: break-all; font-size: 0.88rem; }
  .footer-word {
    font-size: clamp(6rem, 26vw, 24rem);
    line-height: 0.8;
    text-align: center;
    margin: 4rem 0 1.5rem;
    color: transparent;
    -webkit-text-stroke: 1px rgba(201, 162, 90, 0.28);
    letter-spacing: 0.02em;
    user-select: none;
  }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 1.5rem; font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--mute); }
  .footer-legal { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .footer-legal a { color: var(--cream-2); transition: color 0.2s; }
  .footer-legal a:hover { color: var(--brass); }
  @media (max-width: 820px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-cols { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .footer-cols { grid-template-columns: 1fr; }
    .site-footer { padding-bottom: calc(6rem + env(safe-area-inset-bottom)); }
  }
</style>
