---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';
import { business, services, hoursDisplay, reviews, gallery, heroImage } from '../data/site';

const star = '<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg>';
const stars = star.repeat(5);
---

<Layout>
  <Header home />

  <main>
    <!-- ======================= HERO ======================= -->
    <section class="hero" aria-label="Parker Modern Classic Hair">
      <div class="hero-media" aria-hidden="true">
        <img src={heroImage} alt="" fetchpriority="high" />
      </div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-lines" aria-hidden="true"><span></span><span></span><span></span></div>

      <div class="wrap hero-inner">
        <div class="hero-copy">
          <p class="kicker mask"><span>Est. {business.est} · Calhoun, Georgia</span></p>
          <h1 class="hero-title display">
            <span class="mask" style="--d:.05s"><span>Modern</span></span>
            <span class="mask" style="--d:.15s"><span class="serif-i">Classic</span></span>
            <span class="mask" style="--d:.25s"><span>Hair<em class="brass">.</em></span></span>
          </h1>
          <p class="hero-sub" data-reveal style="--d:.45s">
            Sharp fades. Straight razor beard work. Classic cuts done right.
            Ben's chair on South Wall Street, downtown Calhoun.
          </p>
          <div class="hero-actions" data-reveal style="--d:.55s">
            <a href="/book" class="btn">Book Your Cut <span class="arrow">→</span></a>
            <a href="#services" class="btn btn-ghost">See the Menu</a>
          </div>
        </div>

        <aside class="hero-ticket frame" data-reveal="right" style="--d:.6s">
          <div class="ticket-row">
            <span class="kicker plain">Now Booking</span>
            <span class="live"><i></i>Ben's Chair</span>
          </div>
          <div class="ticket-rating">
            <span class="display">{business.rating}</span>
            <div>
              <span class="stars" set:html={stars} />
              <p>{business.reviewCount} reviews</p>
            </div>
          </div>
          <div class="ticket-today" id="today-hours">
            <span class="muted">Today</span>
            <strong>Check hours below</strong>
          </div>
          <a href="/book" class="btn btn-block btn-sm">Grab a Time</a>
        </aside>
      </div>

      <div class="hero-strip">
        <div class="wrap strip-inner">
          <a href={business.mapsHref} target="_blank" rel="noopener">
            <span class="muted">Find Us</span>{business.street}, {business.city}
          </a>
          <a href={business.phoneHref}><span class="muted">Call</span>{business.phone}</a>
          <a href="#services" class="scroll-cue" aria-label="Scroll to services"><span></span></a>
        </div>
      </div>
    </section>

    <Marquee />

    <!-- ======================= SERVICES ======================= -->
    <section id="services" class="section services">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="kicker" data-reveal>The Menu</p>
            <h2 class="h2">
              <span class="mask"><span>Pick your</span></span>
              <span class="mask" style="--d:.1s"><span class="serif-i">cut.</span></span>
            </h2>
          </div>
          <p class="lede" data-reveal style="--d:.15s">
            Straight prices. No upsell. Every cut is precise and detailed, with a complimentary wash and style if you want it.
          </p>
        </div>

        <div class="board" data-reveal="scale">
          <div class="board-top">
            <span>Parker</span>
            <span class="board-title display">Price List</span>
            <span>Est. {business.est}</span>
          </div>
          <ol class="board-list">
            {services.map((s, i) => (
              <li class="svc" data-reveal style={`--d:${0.05 * i}s`}>
                <a href={`/book?service=${s.id}`} class="svc-link" aria-label={`Book ${s.name}, ${s.price}, ${s.time}`}>
                  <span class="svc-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-main">
                    <span class="svc-name-row">
                      <span class="svc-name display">{s.name}</span>
                      {s.tag && <span class="svc-tag">{s.tag}</span>}
                      <span class="svc-leader" aria-hidden="true"></span>
                    </span>
                    <span class="svc-desc">{s.desc}</span>
                  </span>
                  <span class="svc-time">{s.time}</span>
                  <span class="svc-price display">{s.price}</span>
                  <span class="svc-go" aria-hidden="true">Book →</span>
                </a>
              </li>
            ))}
          </ol>
          <div class="board-foot">
            <span>Walk-ins welcome when the chair is open</span>
            <a href="/book" class="btn btn-sm">Book Online <span class="arrow">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================= WORK ======================= -->
    <section id="work" class="section work">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="kicker" data-reveal>The Craft</p>
            <h2 class="h2">
              <span class="mask"><span>Clean lines.</span></span>
              <span class="mask" style="--d:.1s"><span class="serif-i">No shortcuts.</span></span>
            </h2>
          </div>
          <a href="/book" class="btn btn-ghost" data-reveal style="--d:.15s">Book a Cut <span class="arrow">→</span></a>
        </div>

        <div class="gallery">
          {gallery.map((g, i) => (
            <figure class={`g-item ${g.cls}`} data-reveal style={`--d:${0.06 * i}s`}>
              <img src={g.src} alt={g.label} loading="lazy" decoding="async" />
              <figcaption>
                <span class="g-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="g-label display">{g.label}</span>
                <span class="g-note">{g.note}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="gallery-note muted">Style reference imagery.</p>
      </div>
    </section>

    <Marquee dark reverse words={['Precision', 'Patience', 'Consistency', 'Straight Razor']} />

    <!-- ======================= ABOUT ======================= -->
    <section id="about" class="section about">
      <div class="wrap about-grid">
        <div class="about-photo" data-reveal="left">
          <div class="photo-back" aria-hidden="true"></div>
          <div class="photo-frame frame">
            <img src="/ben-portrait.jpg" alt="Ben, barber and owner of Parker Modern Classic Hair" width="486" height="607" loading="lazy" />
            <span class="photo-tag">Ben · Barber</span>
          </div>
          <span class="photo-vert" aria-hidden="true">Parker · Calhoun GA · Est. {business.est}</span>
        </div>

        <div class="about-copy">
          <p class="kicker" data-reveal>The Barber</p>
          <h2 class="h2">
            <span class="mask"><span>Meet</span></span>
            <span class="mask" style="--d:.1s"><span class="serif-i">Ben.</span></span>
          </h2>
          <div class="about-text" data-reveal style="--d:.15s">
            <p class="about-lead">Parker Modern Classic Hair is Ben's chair. He listens first, then executes with precision.</p>
            <p>Clients come for the fade and stay for the consistency. He is known for clean lines, patience (especially with kids), and sending every client out sharper than when they sat down.</p>
            <p class="muted">Classic neighborhood shop. Modern standards.</p>
          </div>
          <dl class="about-stats" data-reveal style="--d:.25s">
            <div><dt class="display">{business.rating}</dt><dd>Star rating</dd></div>
            <div><dt class="display">{business.reviewCount}</dt><dd>Client reviews</dd></div>
            <div><dt class="display">{business.est}</dt><dd>Established</dd></div>
          </dl>
          <a href="/book" class="btn" data-reveal style="--d:.3s">Sit in Ben's Chair <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- ======================= REVIEWS ======================= -->
    <section id="reviews" class="section reviews">
      <div class="wrap">
        <div class="rev-head">
          <p class="kicker" data-reveal>Word on the Street</p>
          <div class="rev-score" data-reveal style="--d:.1s">
            <span class="display">{business.rating}</span>
            <div>
              <span class="stars" set:html={stars} />
              <p>{business.reviewCount} reviews</p>
            </div>
          </div>
        </div>

        <div class="rev-grid">
          {reviews.map((r, i) => (
            <blockquote class={`rev rev-${i + 1}`} data-reveal style={`--d:${0.1 * i}s`}>
              <span class="rev-mark display" aria-hidden="true">“</span>
              <span class="stars" set:html={stars} />
              <p class={i === 0 ? 'rev-q big' : 'rev-q'}>{r.quote}</p>
              <footer><span class="rule-dash"></span>{r.name}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================= VISIT / CTA ======================= -->
    <section id="visit" class="section visit">
      <div class="visit-bg" aria-hidden="true"></div>
      <div class="wrap">
        <div class="visit-head">
          <p class="kicker" data-reveal>Ready When You Are</p>
          <h2 class="visit-title display">
            <span class="mask"><span>Your chair</span></span>
            <span class="mask" style="--d:.1s"><span class="serif-i brass">is waiting.</span></span>
          </h2>
          <div class="visit-actions" data-reveal style="--d:.2s">
            <a href="/book" class="btn">Book Appointment <span class="arrow">→</span></a>
            <a href={business.phoneHref} class="btn btn-ghost">Call {business.phone}</a>
          </div>
        </div>

        <div class="visit-grid">
          <div class="hours-card frame" data-reveal>
            <p class="kicker plain">Hours</p>
            <ul class="hours">
              {hoursDisplay.map((h) => (
                <li data-day={h.idx} class={h.label === 'Closed' ? 'closed' : ''}>
                  <span>{h.day}</span>
                  <span class="dots" aria-hidden="true"></span>
                  <span>{h.label}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="contact-card" data-reveal style="--d:.1s">
            <a href={business.mapsHref} target="_blank" rel="noopener" class="contact-row">
              <span class="kicker plain">Address</span>
              <span class="contact-val">{business.street}<br />{business.city}, {business.region} {business.zip}</span>
              <span class="contact-go">Open in Google Maps ↗</span>
            </a>
            <a href={business.phoneHref} class="contact-row">
              <span class="kicker plain">Phone</span>
              <span class="contact-val">{business.phone}</span>
              <span class="contact-go">Tap to call →</span>
            </a>
            <a href={`mailto:${business.email}`} class="contact-row">
              <span class="kicker plain">Email</span>
              <span class="contact-val email">{business.email}</span>
              <span class="contact-go">Send a note →</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Mobile sticky book bar -->
  <div class="sticky-book" role="region" aria-label="Quick booking">
    <a href={business.phoneHref} class="sb-call" aria-label={`Call ${business.phone}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"/></svg>
    </a>
    <a href="/book" class="btn sb-book">Book Now <span class="arrow">→</span></a>
  </div>
</Layout>

<script>
  import { hours, hoursDisplay } from '../data/site';
  function fmt(t: number) {
    const h = Math.floor(t);
    const m = Math.round((t % 1) * 60);
    const hh = h % 12 === 0 ? 12 : h % 12;
    return `${hh}${m ? ':' + String(m).padStart(2, '0') : ''} ${h >= 12 ? 'PM' : 'AM'}`;
  }
  function initToday() {
    const now = new Date();
    const d = now.getDay();
    document.querySelectorAll(`.hours li[data-day="${d}"]`).forEach((li) => li.classList.add('today'));
    const el = document.getElementById('today-hours');
    if (!el) return;
    const h = hours[d];
    const t = now.getHours() + now.getMinutes() / 60;
    let msg = '';
    if (h && t < h.open) msg = `Opens ${fmt(h.open)} today`;
    else if (h && t < h.close) msg = `Open now until ${fmt(h.close)}`;
    else {
      for (let i = 1; i <= 7; i++) {
        const n = (d + i) % 7;
        const nh = hours[n];
        if (nh) {
          const name = i === 1 ? 'tomorrow' : hoursDisplay.find((x) => x.idx === n)!.day;
          msg = `Closed now · Opens ${name} ${fmt(nh.open)}`;
          break;
        }
      }
    }
    el.innerHTML = `<span class="muted">Today</span><strong>${msg}</strong>`;
  }
  document.addEventListener('astro:page-load', initToday);
</script>

<style>
  /* ================= HERO ================= */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-media { position: absolute; inset: 0; z-index: -3; }
  .hero-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
    filter: grayscale(0.5) sepia(0.25) contrast(1.15) brightness(0.82);
    animation: kenburns 22s var(--ease) both;
    transform-origin: 65% 35%;
  }
  @keyframes kenburns { from { transform: scale(1.18); } to { transform: scale(1.02); } }
  .hero-shade {
    position: absolute; inset: 0; z-index: -2;
    background:
      radial-gradient(ellipse at 70% 30%, transparent 0%, rgba(10, 9, 8, 0.55) 60%, rgba(10, 9, 8, 0.92) 100%),
      linear-gradient(180deg, rgba(10, 9, 8, 0.6) 0%, rgba(10, 9, 8, 0.1) 30%, rgba(10, 9, 8, 0.55) 65%, var(--ink) 100%),
      linear-gradient(90deg, rgba(10, 9, 8, 0.85) 0%, rgba(10, 9, 8, 0.2) 60%);
  }
  .hero-lines { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero-lines span { position: absolute; top: 0; bottom: 0; width: 1px; background: linear-gradient(180deg, transparent, rgba(239, 230, 210, 0.08) 30%, rgba(239, 230, 210, 0.08) 70%, transparent); }
  .hero-lines span:nth-child(1) { left: 25%; }
  .hero-lines span:nth-child(2) { left: 50%; }
  .hero-lines span:nth-child(3) { left: 75%; }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 3rem;
    padding-top: calc(var(--header-h) + 1.75rem);
    padding-bottom: 2.25rem;
  }
  .hero-title {
    font-size: clamp(4.4rem, min(15vw, 16vh), 15rem);
    line-height: 0.84;
    margin: 1.2rem 0 1.6rem;
    letter-spacing: -0.01em;
  }
  .hero-title .serif-i {
    font-size: 1.02em;
    line-height: 0.8;
    color: var(--brass);
    padding-left: 0.32em;
    letter-spacing: -0.03em;
  }
  .hero-title em { font-style: normal; }
  .hero-sub { max-width: 30rem; font-size: clamp(1.02rem, 1.4vw, 1.2rem); color: var(--cream-2); margin-bottom: 1.8rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  .hero-ticket {
    width: 300px;
    padding: 1.6rem;
    background: rgba(18, 17, 16, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--line-2);
    display: grid;
    gap: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .ticket-row { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .live { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cream-2); }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: #7bd389; box-shadow: 0 0 0 0 rgba(123, 211, 137, 0.6); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(123, 211, 137, 0); } 100% { box-shadow: 0 0 0 0 rgba(123, 211, 137, 0); } }
  .ticket-rating { display: flex; align-items: center; gap: 1rem; padding-block: 1.1rem; border-block: 1px dashed var(--line-2); }
  .ticket-rating .display { font-size: 3.6rem; line-height: 0.9; color: var(--cream); }
  .ticket-rating p { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); margin-top: 0.2rem; }
  .ticket-today { display: grid; gap: 0.15rem; font-size: 0.9rem; }
  .ticket-today :global(.muted) { font-size: 0.68rem; letter-spacing: 0.24em; text-transform: uppercase; }
  .ticket-today :global(strong) { font-weight: 600; color: var(--cream); }

  .hero-strip { border-top: 1px solid var(--line); background: rgba(10, 9, 8, 0.55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .strip-inner { display: flex; align-items: center; gap: 3rem; min-height: 64px; font-size: 0.9rem; }
  .strip-inner > a { display: inline-flex; align-items: baseline; gap: 0.8rem; color: var(--cream-2); transition: color 0.2s; }
  .strip-inner > a:hover { color: var(--brass); }
  .strip-inner .muted { font-size: 0.65rem; letter-spacing: 0.28em; text-transform: uppercase; }
  .scroll-cue { margin-left: auto; width: 26px; height: 40px; border: 1px solid var(--line-2); border-radius: 13px; position: relative; }
  .scroll-cue span { position: absolute; left: 50%; top: 8px; width: 2px; height: 8px; background: var(--brass); transform: translateX(-50%); animation: cue 1.8s var(--ease) infinite; }
  @keyframes cue { 0% { opacity: 0; transform: translate(-50%, 0); } 40% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, 14px); } }

  /* ================= SECTION HEADS ================= */
  .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem 4rem; flex-wrap: wrap; margin-bottom: clamp(3rem, 6vw, 5rem); }

  /* ================= SERVICES BOARD ================= */
  .services { background: var(--char); background-image: radial-gradient(circle at 95% 35%, rgba(201, 162, 90, 0.08), transparent 35%); }
  .board {
    position: relative;
    background: var(--ink);
    border: 1px solid var(--line-2);
    outline: 1px solid var(--line-2);
    outline-offset: 7px;
    padding: clamp(1.25rem, 3vw, 2.75rem);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8);
    margin: 8px;
  }
  .board-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.4rem;
    border-bottom: 3px double var(--line-2);
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .board-top span:last-child { text-align: right; }
  .board-title { font-size: clamp(1.6rem, 3vw, 2.4rem); letter-spacing: 0.14em; color: var(--brass); }
  .board-list { list-style: none; }
  .svc { border-bottom: 1px solid var(--line); }
  .svc-link {
    display: grid;
    grid-template-columns: 3rem 1fr auto auto 5.5rem;
    align-items: center;
    gap: 1.5rem;
    padding: 1.7rem 0.75rem;
    position: relative;
    transition: background 0.35s var(--ease), padding 0.35s var(--ease);
  }
  .svc-link::before {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--brass);
    transform: scaleY(0);
    transition: transform 0.35s var(--ease);
  }
  .svc-link:hover { background: linear-gradient(90deg, rgba(201, 162, 90, 0.09), transparent 80%); padding-left: 1.5rem; }
  .svc-link:hover::before { transform: scaleY(1); }
  .svc-num { font-size: 0.75rem; letter-spacing: 0.2em; color: var(--brass); }
  .svc-main { display: grid; gap: 0.35rem; min-width: 0; }
  .svc-name-row { display: flex; align-items: center; gap: 0.9rem; }
  .svc-name { font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1; letter-spacing: 0.01em; white-space: nowrap; }
  .svc-tag { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink); background: var(--brass); padding: 0.3rem 0.55rem; white-space: nowrap; }
  .svc-leader { flex: 1; min-width: 1rem; border-bottom: 1px dotted rgba(201, 162, 90, 0.45); transform: translateY(0.4em); }
  .svc-desc { color: var(--mute); font-size: 0.92rem; max-width: 38rem; }
  .svc-time { font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--cream-2); border: 1px solid var(--line); padding: 0.35rem 0.7rem; white-space: nowrap; }
  .svc-price { font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 1; color: var(--brass); min-width: 4.2ch; text-align: right; }
  .svc-go { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--brass); opacity: 0; transform: translateX(-8px); transition: opacity 0.3s, transform 0.35s var(--ease); text-align: right; }
  .svc-link:hover .svc-go { opacity: 1; transform: none; }
  .board-foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; padding-top: 1.6rem; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--mute); }

  /* ================= GALLERY ================= */
  .work { background: var(--ink); }
  .gallery {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(60px, 7.2vw, 100px);
    gap: clamp(0.5rem, 1vw, 1rem);
  }
  .g-item { position: relative; overflow: hidden; background: var(--char-2); margin: 0; cursor: default; }
  .g-a { grid-column: 1 / span 7; grid-row: 1 / span 6; }
  .g-b { grid-column: 8 / span 5; grid-row: 1 / span 3; }
  .g-c { grid-column: 8 / span 3; grid-row: 4 / span 3; }
  .g-d { grid-column: 11 / span 2; grid-row: 4 / span 3; }
  .g-e { grid-column: 1 / span 4; grid-row: 7 / span 4; }
  .g-f { grid-column: 5 / span 8; grid-row: 7 / span 4; }
  .g-item img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(0.9) sepia(0.2) contrast(1.15) brightness(0.8);
    transform: scale(1.04);
    transition: transform 1.2s var(--ease), filter 0.8s var(--ease);
  }
