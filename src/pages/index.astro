---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <nav style="position: fixed; top: 0; width: 100%; background: rgba(10,10,10,0.9); backdrop-filter: blur(10px); z-index: 100; padding: 1rem 0;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
      <div style="font-size: 1.2rem; font-weight: 700; letter-spacing: 0.2em;">PARKER</div>
      <div style="display: flex; gap: 2rem; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em;">
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#reviews">Reviews</a>
        <a href="#book" class="btn" style="padding: 0.5rem 1.5rem; font-size: 0.8rem;">Book Now</a>
      </div>
    </div>
  </nav>

  <section style="min-height: 100vh; display: flex; align-items: center; background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%); position: relative; overflow: hidden;">
    <div class="container" style="position: relative; z-index: 2;">
      <p style="color: var(--accent); letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 1rem;">Calhoun, Georgia</p>
      <h1 style="font-size: clamp(3rem, 8vw, 7rem); line-height: 0.9; margin-bottom: 1.5rem;">
        MODERN<br/>CLASSIC<br/><span style="color: var(--accent);">HAIR</span>
      </h1>
      <p style="font-size: 1.4rem; max-width: 500px; margin-bottom: 2rem; color: #ccc;">
        Clean fades. Sharp beard work. Precise cuts by Ben. The neighborhood shop with modern standards.
      </p>
      <a href="#book" class="btn">Book Your Cut</a>
    </div>
    <div style="position: absolute; right: -10%; top: 10%; width: 50%; height: 80%; background: url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1200&q=80') center/cover; opacity: 0.4; filter: grayscale(100%) contrast(1.2); mask-image: linear-gradient(to left, black 40%, transparent 100%);"></div>
  </section>

  <section id="services" style="background: #111;">
    <div class="container">
      <h2 style="font-size: 3rem; text-align: center; margin-bottom: 1rem;">Services</h2>
      <p style="text-align: center; color: var(--muted); margin-bottom: 4rem; max-width: 600px; margin-left: auto; margin-right: auto;">Precision work. Every cut tailored. Walk-ins welcome when available.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
        <div style="background: #1a1a1a; padding: 2rem; border-radius: 12px; border: 1px solid #222;">
          <h3 style="color: var(--accent); margin-bottom: 0.5rem;">Men's Haircut</h3>
          <p>Clean fades, textured crops, classic styles. Ben listens and delivers exactly what you want.</p>
        </div>
        <div style="background: #1a1a1a; padding: 2rem; border-radius: 12px; border: 1px solid #222;">
          <h3 style="color: var(--accent); margin-bottom: 0.5rem;">Beard Trim</h3>
          <p>Sharp lines. Hot towel finish available. From neat to full sculpted.</p>
        </div>
        <div style="background: #1a1a1a; padding: 2rem; border-radius: 12px; border: 1px solid #222;">
          <h3 style="color: var(--accent); margin-bottom: 0.5rem;">Hot Towel Shave</h3>
          <p>Traditional straight-razor experience. Smooth, precise, classic.</p>
        </div>
        <div style="background: #1a1a1a; padding: 2rem; border-radius: 12px; border: 1px solid #222;">
          <h3 style="color: var(--accent); margin-bottom: 0.5rem;">Head Shave</h3>
          <p>Clean, even, professional. Perfect for the bold look.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="about">
    <div class="container" style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
      <div>
        <h2 style="font-size: 3rem; margin-bottom: 1.5rem;">Meet Ben</h2>
        <p style="font-size: 1.1rem; margin-bottom: 1rem;">Parker Modern Classic Hair is Ben’s chair. Community-focused, detail-obsessed, and known for making every client look and feel their best.</p>
        <p style="margin-bottom: 1rem;">Clients rave about his patience (especially with kids), his ability to understand exactly the look you want, and the quality of every fade and beard line.</p>
        <p>A classic neighborhood shop with modern grooming standards. Come for the cut. Stay for the vibe.</p>
      </div>
      <div style="background: #1a1a1a; aspect-ratio: 1; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 4rem; color: var(--accent);">✂️</div>
    </div>
  </section>

  <section id="reviews" style="background: #111;">
    <div class="container">
      <h2 style="font-size: 3rem; text-align: center; margin-bottom: 1rem;">5.0 from 28+ Clients</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 3rem;">
        <div style="background: #1a1a1a; padding: 2rem; border-radius: 12px;">
          <p style="font-style: italic; margin-bottom: 1rem;">"Ben has been cutting my hair for over a year now and I could not ask for a better barber. He understands hair styles and offers advice on how to get the look you are after."</p>
          <p style="color: var(--accent);">— Jordan Stone</p>
        </div>
        <div style="background: #1a1a1a; padding: 2rem; border-radius: 12px;">
          <p style="font-style: italic; margin-bottom: 1rem;">"Ben took his time to listen and executed it exactly how I wanted it. He is very efficient but also detailed. 10/10."</p>
          <p style="color: var(--accent);">— Kotaro Goto</p>
        </div>
        <div style="background: #1a1a1a; padding: 2rem; border-radius: 12px;">
          <p style="font-style: italic; margin-bottom: 1rem;">"Highly recommend Ben for any haircut or beard trim. He had my raggedy self looking like a million dollars."</p>
          <p style="color: var(--accent);">— Donnie Carter</p>
        </div>
      </div>
    </div>
  </section>

  <section id="hours">
    <div class="container" style="text-align: center;">
      <h2 style="font-size: 3rem; margin-bottom: 2rem;">Hours</h2>
      <div style="display: inline-block; text-align: left; background: #1a1a1a; padding: 2rem 3rem; border-radius: 12px;">
        <p><strong>Monday</strong> 12:00 PM – 7:00 PM</p>
        <p><strong>Tuesday</strong> 9:00 AM – 5:30 PM</p>
        <p><strong>Wednesday</strong> 9:00 AM – 5:00 PM</p>
        <p><strong>Thursday</strong> 11:00 AM – 6:00 PM</p>
        <p><strong>Friday</strong> 9:00 AM – 5:00 PM</p>
        <p><strong>Saturday</strong> Closed</p>
        <p><strong>Sunday</strong> Closed</p>
      </div>
    </div>
  </section>

  <section id="book" style="background: linear-gradient(135deg, #1a1a1a, #0a0a0a); text-align: center;">
    <div class="container">
      <h2 style="font-size: 3.5rem; margin-bottom: 1rem;">Ready for the Cut?</h2>
      <p style="font-size: 1.2rem; margin-bottom: 2rem; color: #ccc;">Book your appointment now. Walk-ins welcome when Ben has the chair open.</p>
      <a href="https://www.parkermodernclassichair.com/s/appointments" class="btn" style="font-size: 1.1rem;">Book Appointment</a>
      <p style="margin-top: 2rem; color: var(--muted);">111 S Wall St Suite B, Calhoun, GA 30701</p>
    </div>
  </section>

  <footer style="padding: 3rem 0; text-align: center; color: var(--muted); border-top: 1px solid #222;">
    <div class="container">
      <p>Parker Modern Classic Hair · Calhoun, GA</p>
      <p style="margin-top: 0.5rem; font-size: 0.9rem;">Built for Ben by Jeff. The greatest barber site the world has ever seen.</p>
    </div>
  </footer>
</Layout>