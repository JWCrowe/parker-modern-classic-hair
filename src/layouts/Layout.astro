---
import { ViewTransitions } from 'astro:transitions';

const { title = "Parker Modern Classic Hair | Calhoun, GA", description = "Precision cuts, sharp fades, and classic grooming by Ben in Calhoun, Georgia." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <ViewTransitions />
    <style is:global>
      :root {
        --bg: #070707;
        --surface: #111111;
        --surface-2: #1a1a1a;
        --text: #f4f1ea;
        --muted: #8a847a;
        --accent: #c9a227;
        --accent-soft: rgba(201, 162, 39, 0.12);
        --border: #262626;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3, h4 {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.05;
      }
      a { color: var(--accent); text-decoration: none; transition: color 0.2s; }
      a:hover { color: #e0c15a; }
      .container { max-width: 1140px; margin: 0 auto; padding: 0 1.5rem; }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--accent);
        color: #0a0a0a;
        padding: 0.95rem 2.2rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        border: none;
        cursor: pointer;
        transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s;
      }
      .btn:hover {
        background: #d4b03a;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(201, 162, 39, 0.25);
      }
      .btn-outline {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border);
      }
      .btn-outline:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: var(--accent-soft);
      }
      section { padding: 7rem 0; }
      @media (max-width: 768px) {
        section { padding: 5rem 0; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>